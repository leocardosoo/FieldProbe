<Window x:Class="FieldProbe.App.Views.ConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FieldProbe.App.ViewModels"
        xmlns:mvvm="clr-namespace:FieldProbe.App.Mvvm"
        Title="{Binding Title}" Width="620" SizeToContent="Height" MaxHeight="900"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12.5" Background="{StaticResource WindowBackground}">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <DataTemplate DataType="{x:Type vm:OptionFieldViewModel}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" />

                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                <PasswordBox Grid.Column="1" mvvm:PasswordHelper.BoundPassword="{Binding Value, Mode=TwoWay}"
                             Visibility="{Binding IsPassword, Converter={StaticResource BoolToVis}}" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}"
                          Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                <CheckBox Grid.Column="1" IsChecked="{Binding BoolValue}" VerticalAlignment="Center" Content="Sim"
                          Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}" />

                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Help}" Margin="0,2,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Help}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16">
        <!-- Botões -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancelar" IsCancel="True" MinWidth="90" />
            <Button Content="Salvar" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="90" Margin="0" Click="Save_Click" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Foreground="{StaticResource BadBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />

        <StackPanel>
            <!-- Protocolo -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Protocolo" Style="{StaticResource SectionTitle}" />
                    <ComboBox ItemsSource="{Binding Drivers}" SelectedItem="{Binding SelectedDriver}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Protocol}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Conexão -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.ColumnSpan="2" Text="Conexão" Style="{StaticResource SectionTitle}" />

                    <TextBlock Grid.Row="1" Text="Nome" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Text="{Binding HostLabel}" Style="{StaticResource Label}" />
                    <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,3" IsEditable="True" ItemsSource="{Binding HostSuggestions}"
                              Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Text="Porta" Style="{StaticResource Label}" Visibility="{Binding UsesPort, Converter={StaticResource BoolToVis}}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3" Width="120" HorizontalAlignment="Left"
                             Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding UsesPort, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Grid.Row="4" Text="Timeout (ms)" Style="{StaticResource Label}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,3" Width="120" HorizontalAlignment="Left" Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,8,0,0">
                        <Button Content="Testar rede (ping + porta)" HorizontalAlignment="Left" Command="{Binding TestCommand}" />
                        <TextBlock Text="{Binding TestResult}" Style="{StaticResource Muted}" FontFamily="Consolas" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Opções do protocolo -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Opções do protocolo" Style="{StaticResource SectionTitle}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
                        <ItemsControl ItemsSource="{Binding Options}" />
                    </ScrollViewer>
                    <TextBlock Text="{Binding AddressHelp}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
