<Window x:Class="FieldProbe.App.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="820" Height="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12.5" Background="{StaticResource WindowBackground}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Copiar relatório" Click="Copy_Click" />
            <Button Content="Fechar" Style="{StaticResource PrimaryButton}" IsCancel="True" IsDefault="True" Margin="0" Click="Close_Click" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" x:Name="HeaderText" Style="{StaticResource SectionTitle}" FontSize="15" />

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="ResultsGrid">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="34">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE946;" />
                                            <Setter Property="Foreground" Value="#656D76" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Ok">
                                                    <Setter Property="Text" Value="&#xE73E;" />
                                                    <Setter Property="Foreground" Value="#1A7F37" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter Property="Text" Value="&#xE7BA;" />
                                                    <Setter Property="Foreground" Value="#9A6700" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                    <Setter Property="Text" Value="&#xEA39;" />
                                                    <Setter Property="Foreground" Value="#CF222E" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Categoria" Binding="{Binding Category, Mode=OneWay}" Width="165" FontWeight="SemiBold" />
                    <DataGridTemplateColumn Header="Resultado" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,4" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                <DataGrid.Resources>
                    <Style TargetType="DataGridRow">
                        <Setter Property="MinHeight" Value="26" />
                    </Style>
                </DataGrid.Resources>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
