<Window x:Class="FieldProbe.App.Views.ScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scanner de rede OT" Width="1180" Height="780" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Icon="/Assets/fieldprobe.ico"
        FontFamily="Segoe UI" FontSize="12.5" Background="{StaticResource WindowBackground}">
    <Window.Resources>
        <!-- Texto longo: corta com "…" e mostra tudo no tooltip -->
        <Style x:Key="TrimCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="ToolTipService.ShowDuration" Value="30000" />
        </Style>
        <!-- Link discreto (Industriais | Todas | Nenhuma); fica em negrito quando é o perfil ativo -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#0F6CBD" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Txt" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent" Padding="2,0" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Txt" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PortGroup" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D8DEE4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,6,10,4" />
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#57606A" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Uma porta: checkbox + número alinhado + nome -->
        <DataTemplate x:Key="PortItemTemplate">
            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2,12,2" VerticalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Definition.Port}" FontFamily="Consolas" Foreground="#8C959F" Width="44" />
                    <TextBlock Text="{Binding Definition.Name}" />
                </StackPanel>
            </CheckBox>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="12">

        <!-- Configuração -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel>
                    <WrapPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                        </Style>
                    </WrapPanel.Resources>
                    <TextBlock Text="Faixa de IPs" />
                    <TextBox Width="300" Margin="0,0,14,0" FontFamily="Consolas" Text="{Binding RangeText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Ex.: 192.168.1.0/24 · 192.168.1.10-50 · 10.0.0.1-10.0.0.20 · 10.0.0.5, 10.0.0.9" />
                    <TextBlock Text="Timeout (ms)" />
                    <TextBox Width="60" Margin="0,0,14,0" Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tempo de espera por porta. Redes lentas/VPN: 800+" />
                    <TextBlock Text="Paralelo" />
                    <TextBox Width="50" Margin="0,0,14,0" Text="{Binding Parallelism, UpdateSourceTrigger=PropertyChanged}" ToolTip="Hosts verificados ao mesmo tempo. Redes OT sensíveis: use 8 a 16." />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Foreground="White" FontSize="12" Margin="0,0,6,0" /><TextBlock Text="Iniciar varredura" Foreground="White" Margin="0" /></StackPanel>
                    </Button>
                    <Button Content="Parar" Command="{Binding StopCommand}" />
                </WrapPanel>

                <!-- Portas a verificar -->
                <DockPanel Margin="0,12,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Industriais" Style="{StaticResource LinkButton}" Tag="{Binding IsIndustrialPreset}"
                                Command="{Binding SelectIndustrialCommand}" ToolTip="Só os protocolos de automação" />
                        <TextBlock Text="|" Foreground="#C4CBD2" Margin="6,0" />
                        <Button Content="Todas" Style="{StaticResource LinkButton}" Tag="{Binding IsAllPreset}" Command="{Binding SelectAllCommand}" />
                        <TextBlock Text="|" Foreground="#C4CBD2" Margin="6,0" />
                        <Button Content="Nenhuma" Style="{StaticResource LinkButton}" Tag="{Binding IsNonePreset}" Command="{Binding SelectNoneCommand}" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Portas a verificar" FontWeight="SemiBold" />
                        <Run Text="·" Foreground="#8C959F" />
                        <Run Text="{Binding SelectedPortsText, Mode=OneWay}" Foreground="#57606A" />
                    </TextBlock>
                </DockPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PortGroup}">
                        <StackPanel>
                            <TextBlock Text="Protocolos industriais" Style="{StaticResource GroupTitle}" />
                            <ItemsControl ItemsSource="{Binding IndustrialPorts}" ItemTemplate="{StaticResource PortItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource PortGroup}">
                        <StackPanel>
                            <TextBlock Text="TI e acesso remoto" Style="{StaticResource GroupTitle}" />
                            <ItemsControl ItemsSource="{Binding ItPorts}" ItemTemplate="{StaticResource PortItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <ProgressBar Height="6" Margin="0,10,0,4" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Foreground="{StaticResource WarnBrush}"
                           Text="⚠ Use somente em redes que você tem autorização para analisar. A varredura só abre conexões TCP e faz handshakes de identificação, mas equipamentos antigos podem ser sensíveis: em produção, prefira paralelismo baixo." />
            </StackPanel>
        </Border>

        <!-- Rodapé -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Command="{Binding ExportCommand}">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="12" /><TextBlock Text="Exportar CSV" /></StackPanel>
            </Button>
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding CreateConnectionCommand}" ToolTip="Cria a conexão no projeto com o protocolo mais completo encontrado">
                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Foreground="White" FontSize="12" Margin="0,0,6,0" /><TextBlock Text="Criar conexão" Foreground="White" Margin="0" /></StackPanel>
            </Button>
            <Button Content="Fechar" Margin="0" Click="Close_Click" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="6" />
                <RowDefinition Height="200" MinHeight="80" />
            </Grid.RowDefinitions>

            <!-- Resultados -->
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Risco" Width="80" SortMemberPath="WorstSeverity">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="7,1" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DAFBE1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding WorstSeverity}" Value="Warning"><Setter Property="Background" Value="#FFF8C5" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding WorstSeverity}" Value="Critical"><Setter Property="Background" Value="#FFEBE9" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SeverityText}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="IP" Binding="{Binding Ip, Mode=OneWay}" Width="115" FontFamily="Consolas" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Hostname" Binding="{Binding Hostname, Mode=OneWay}" Width="130" ElementStyle="{StaticResource TrimCell}" />
                        <DataGridTextColumn Header="MAC" Binding="{Binding Mac, Mode=OneWay}" Width="130" FontFamily="Consolas" ElementStyle="{StaticResource TrimCell}" />
                        <DataGridTextColumn Header="Protocolos" Binding="{Binding ProtocolsText, Mode=OneWay}" Width="190" ElementStyle="{StaticResource TrimCell}" />
                        <DataGridTextColumn Header="Identificação" Binding="{Binding IdentityText, Mode=OneWay}" Width="*" MinWidth="160" ElementStyle="{StaticResource TrimCell}" />
                        <DataGridTextColumn Header="Portas" Binding="{Binding PortsText, Mode=OneWay}" Width="120" FontFamily="Consolas" ElementStyle="{StaticResource TrimCell}" />
                        <DataGridTextColumn Header="Achados" Binding="{Binding FindingsText, Mode=OneWay}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Achados do ativo selecionado -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}">
                        <Run Text="Achados ·" />
                        <Run Text="{Binding SelectedResult.Ip, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,2,0,8" Foreground="#57606A"
                               Text="{Binding SelectedResult.IdentityText, Mode=OneWay}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedResult.Findings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SeverityText}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#57606A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Critical"><Setter Property="Foreground" Value="#CF222E" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter Property="Foreground" Value="#9A6700" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Ok"><Setter Property="Foreground" Value="#1A7F37" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock TextWrapping="Wrap"><Run Text="{Binding Category, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Text="{Binding Recommendation}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
