<Window x:Class="FieldProbe.App.Views.AddressScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Procurar endereços" Width="780" Height="560" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12.5" Background="{StaticResource WindowBackground}">
    <DockPanel Margin="14">
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="SelectionText" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Fechar" IsCancel="True" MinWidth="90" />
                <Button x:Name="ApplyButton" Content="Usar na árvore" Style="{StaticResource PrimaryButton}" Margin="0"
                        IsEnabled="False" Click="Apply_Click"
                        ToolTip="A árvore da conexão passa a mostrar só os endereços marcados" />
            </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderText" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,0,0,4" />
            <TextBlock x:Name="HelpText" Style="{StaticResource Muted}" TextWrapping="Wrap" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Faixa:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="RangeBox" Grid.Column="1" FontFamily="Consolas" Padding="4,3" VerticalContentAlignment="Center" />
                <Button x:Name="StartButton" Grid.Column="2" Content="Procurar" Style="{StaticResource PrimaryButton}"
                        MinWidth="100" Margin="8,0,0,0" IsDefault="True" Click="Start_Click" />
            </Grid>

            <ProgressBar x:Name="Progress" Height="4" Margin="0,10,0,0" Maximum="1" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                      SelectionMode="Extended" RowHeight="28">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Block.Accessible}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Usar" Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Click="Check_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Endereço" Binding="{Binding Block.Title, Mode=OneWay}" Width="160"
                                        FontFamily="Consolas" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Situação" Binding="{Binding StateText, Mode=OneWay}" Width="110" />
                    <DataGridTextColumn Header="Detalhe" Binding="{Binding Block.Detail, Mode=OneWay}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
