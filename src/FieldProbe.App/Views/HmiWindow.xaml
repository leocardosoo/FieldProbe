<Window x:Class="FieldProbe.App.Views.HmiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hmi="clr-namespace:FieldProbe.App.Hmi"
        Title="FieldProbe · Tela de teste (IHM)" Width="1480" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="12.5"
        Background="{StaticResource WindowBackground}" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <hmi:InverseBoolToVisibilityConverter x:Key="InverseB2V" />
        <hmi:NeedleRotateConverter x:Key="NeedleRotate" />
        <hmi:FractionScaleYConverter x:Key="FractionScaleY" />

        <!-- Hachura cinza de elemento sem comunicação (modo Executar), como nos SCADAs -->
        <DrawingBrush x:Key="BadHatch" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#66D0D7DE">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,8,8" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#8C959F" Thickness="1.2" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <LineGeometry StartPoint="0,8" EndPoint="8,0" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- Selo "ALARME ALTO/BAIXO" dos mostradores -->
        <Style x:Key="AlarmBadge" TargetType="Border">
            <Setter Property="Background" Value="#CF222E" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="AlarmBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="PropLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
        <Style x:Key="PropGroup" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#0F6CBD" />
            <Setter Property="Margin" Value="0,14,0,0" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style x:Key="ToolTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="4,8,4,6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ToolboxButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <!-- Ícones da caixa de elementos (24×24, mesmo traço dos símbolos) -->
        <DrawingImage x:Key="IconLampada"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="#2DA44E" Geometry="M12,3 A7,7 0 1 1 11.99,3 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M9,19 L15,19 M10,22 L14,22"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="IconBotao"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="#E6E9ED" Geometry="M3,7 L21,7 L21,17 L3,17 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="#9AA0A6" Geometry="M7,10 L17,10 L17,14 L7,14 Z"></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="IconValor"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="#FFFFFF" Geometry="M2,6 L22,6 L22,18 L2,18 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M6,9 L10,9 L10,15 L6,15 Z M6,12 L10,12 M13,9 L17,9 L17,15 L13,15 Z M13,12 L17,12"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M19,15 L19.6,15"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="IconSetpoint"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="#FFFFFF" Geometry="M2,7 L15,7 L15,17 L2,17 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M5,10 L5,14"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M17,12 L22,12 M19.5,9.5 L22,12 L19.5,14.5"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="IconBarra"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="#E6E9ED" Geometry="M2,9 L22,9 L22,15 L2,15 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="#0F6CBD" Geometry="M2,9 L15,9 L15,15 L2,15 Z"></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M18,7 L18,17"><GeometryDrawing.Pen><Pen Brush="#CF222E" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="IconTexto"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="Transparent" Geometry="M5,5 L19,5 M12,5 L12,19 M9,19 L15,19"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="IconMotor"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="#C4C7CB" Geometry="M3,7 L17,7 L17,17 L3,17 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="#9AA0A6" Geometry="M17,11 L22,11 L22,13 L17,13 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="#9AA0A6" Geometry="M7,4 L12,4 L12,7 L7,7 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="#FFFFFF" Geometry="M10,9.5 A2.5,2.5 0 1 1 9.99,9.5 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M5,19 L15,19"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="IconBomba"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="#9AA0A6" Geometry="M2,12 L7,12 L7,16 L2,16 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="#9AA0A6" Geometry="M12,4 L22,4 L22,8 L12,8 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="#C4C7CB" Geometry="M12,7 A7,7 0 1 1 11.99,7 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M12,14 L12,10 M12,14 L15.5,16 M12,14 L8.5,16"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.3" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="#9AA0A6" Geometry="M7,22 L17,22 L15,20 L9,20 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="IconValvula"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="#C4C7CB" Geometry="M2,10 L12,15 L2,20 Z M22,10 L12,15 L22,20 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M12,15 L12,7"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="#9AA0A6" Geometry="M6,7 A6,4 0 0 1 18,7 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="IconTanque"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="#E6E9ED" Geometry="M6,5 Q6,2 12,2 Q18,2 18,5 L18,19 Q18,22 12,22 Q6,22 6,19 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="#0F6CBD" Geometry="M6.8,12 L17.2,12 L17.2,19 Q17.2,21.2 12,21.2 Q6.8,21.2 6.8,19 Z"></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M18,8 L20,8 M18,12 L20,12 M18,16 L20,16"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="IconEsteira"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="#3E444A" Geometry="M5,8 L19,8 A4,4 0 0 1 19,16 L5,16 A4,4 0 0 1 5,8 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="#C4C7CB" Geometry="M5,10 A2,2 0 1 1 4.99,10 Z M19,10 A2,2 0 1 1 18.99,10 Z"></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M8,12 L16,12"><GeometryDrawing.Pen><Pen Brush="#F2F3F5" Thickness="1.2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M7,16 L7,21 M17,16 L17,21"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="IconSinaleiro"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="#E5534B" Geometry="M8,2 L16,2 L16,7 L8,7 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="#F2C744" Geometry="M8,7 L16,7 L16,12 L8,12 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="#2DA44E" Geometry="M8,12 L16,12 L16,17 L8,17 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M12,17 L12,21 M8,22 L16,22"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="IconTubo"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="#C4C7CB" Geometry="M2,9 L22,9 L22,15 L2,15 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M4,12 L7,12 M10,12 L13,12 M16,12 L19,12"><GeometryDrawing.Pen><Pen Brush="#0F6CBD" Thickness="1.8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="IconEstados"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="#1A7F37" Geometry="M2,7 L22,7 L22,17 L2,17 Z"></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M7,12 L10,15 L17,9"><GeometryDrawing.Pen><Pen Brush="#FFFFFF" Thickness="1.8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="IconMedidor"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="Transparent" Geometry="M4,17 A8,8 0 1 1 20,17"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M16.5,12 A5,5 0 0 1 20,17"><GeometryDrawing.Pen><Pen Brush="#CF222E" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M12,15 L8,9"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.6" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="#3E444A" Geometry="M12,13.5 A1.5,1.5 0 1 1 11.99,13.5 Z"></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="IconTendencia"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="Transparent" Geometry="M3,3 L3,21 L21,21"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.3" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M5,17 L9,12 L12,14 L16,7 L20,9"><GeometryDrawing.Pen><Pen Brush="#0F6CBD" Thickness="1.8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M3,6 L21,6"><GeometryDrawing.Pen><Pen Brush="#CF222E" Thickness="1" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="IconPainel"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="#EEF1F5" Geometry="M3,4 L21,4 L21,20 L3,20 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M3,8 L21,8"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="Transparent" Geometry="M6,6 L11,6"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>
        <DrawingImage x:Key="IconImagem"><DrawingImage.Drawing><DrawingGroup><GeometryDrawing Brush="Transparent" Geometry="M0,0 L24,0 L24,24 L0,24 Z" /><GeometryDrawing Brush="#FFFFFF" Geometry="M3,5 L21,5 L21,19 L3,19 Z"><GeometryDrawing.Pen><Pen Brush="#3E444A" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing><GeometryDrawing Brush="#9AA0A6" Geometry="M5,17 L10,11 L14,15 L16,13 L19,17 Z"></GeometryDrawing><GeometryDrawing Brush="#F2C744" Geometry="M16,8 A1.8,1.8 0 1 1 15.99,8 Z"></GeometryDrawing></DrawingGroup></DrawingImage.Drawing></DrawingImage>

        <!-- Item de cor nos combos: amostra + nome -->
        <DataTemplate x:Key="ColorItem">
            <StackPanel Orientation="Horizontal">
                <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Hex}" BorderBrush="#D0D7DE" BorderThickness="1" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- ===== Barra superior ===== -->
        <Border x:Name="TopBar" DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="FullscreenButton" Content="⛶  Tela cheia" Margin="0,0,12,0" Padding="10,6" Click="Fullscreen_Click"
                            ToolTip="Mostra só a tela, ocupando o monitor inteiro (para TV/andon). Esc para sair." />
                    <CheckBox x:Name="ConfirmBox" Content="Confirmar escritas" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"
                              ToolTip="Pede confirmação antes de cada escrita. Desligue só em bancada de teste, nunca com a máquina em produção." />
                    <ToggleButton x:Name="ModeButton" MinWidth="130" Padding="12,6" Checked="ModeButton_Changed" Unchecked="ModeButton_Changed">
                        <TextBlock x:Name="ModeButtonText" Text="▶  Executar" FontWeight="SemiBold" />
                    </ToggleButton>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tela" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}" />
                    <ComboBox x:Name="ScreensBox" Width="200" DisplayMemberPath="Name" SelectionChanged="ScreensBox_SelectionChanged" />
                    <StackPanel x:Name="ScreenTools" Orientation="Horizontal">
                        <Button Content="+ Nova tela" Margin="8,0,0,0" Click="NewScreen_Click" />
                        <TextBlock Text="Nome" VerticalAlignment="Center" Margin="16,0,6,0" Foreground="{StaticResource MutedBrush}" />
                        <TextBox x:Name="ScreenNameBox" Width="170" LostFocus="ScreenName_LostFocus" KeyDown="ScreenName_KeyDown" />
                        <Button Content="Excluir tela" Margin="8,0,0,0" Click="DeleteScreen_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ModeText" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Configuração da tela (modo edição) ===== -->
        <Border x:Name="ScreenSettingsBar" DockPanel.Dock="Top" Background="#F6F8FA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,4">
            <WrapPanel>
                <!-- Desfazer / copiar / alinhar / zoom -->
                <Button x:Name="UndoButton" Content="↶" FontSize="15" Padding="8,1" Margin="0,2,2,2" Click="Undo_Click" ToolTip="Desfazer (Ctrl+Z)" />
                <Button x:Name="RedoButton" Content="↷" FontSize="15" Padding="8,1" Margin="0,2,10,2" Click="Redo_Click" ToolTip="Refazer (Ctrl+Y)" />
                <Button Content="Copiar" Margin="0,2,2,2" Click="Copy_Click" ToolTip="Copiar os elementos selecionados (Ctrl+C)" />
                <Button Content="Colar" Margin="0,2,10,2" Click="Paste_Click" ToolTip="Colar nesta tela (Ctrl+V). Funciona entre telas" />
                <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="{StaticResource MutedBrush}" />
                <ComboBox x:Name="ZoomBox" Width="78" Margin="0,2,0,2" SelectionChanged="ZoomBox_SelectionChanged" ToolTip="Ctrl + roda do mouse também dá zoom" />
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="14,4" />
                <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="Visual" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}" />
                <ComboBox x:Name="ThemeBox" Width="150" SelectionChanged="ThemeBox_SelectionChanged" DisplayMemberPath="Value" SelectedValuePath="Key" />
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="14,2" />
                <Button Content="Imagem de fundo..." Click="BackgroundImage_Click" ToolTip="Foto ou desenho da máquina/linha (PNG, JPG, BMP). Fica guardada dentro do projeto." />
                <Button x:Name="RemoveImageButton" Content="Remover imagem" Margin="6,0,0,0" Click="RemoveImage_Click" />
                <TextBlock Text="Ajuste" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="{StaticResource MutedBrush}" />
                <ComboBox x:Name="ImageFitBox" Width="110" SelectionChanged="ImageFitBox_SelectionChanged" />
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="14,2" />
                <TextBlock Text="Tamanho da tela" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}" />
                <TextBox x:Name="ScreenWidthBox" Width="56" />
                <TextBlock Text="×" VerticalAlignment="Center" Margin="4,0" />
                <TextBox x:Name="ScreenHeightBox" Width="56" />
                <Button Content="Aplicar" Margin="6,0,0,0" Click="ApplySize_Click" ToolTip="Ex.: 1280×720 (HD), 1920×1080 (Full HD), 1024×600 (painel 7&quot;)" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- ===== Barra de status ===== -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
        </Border>

        <!-- ===== Elementos (modo edição) ===== -->
        <Border x:Name="Toolbox" DockPanel.Dock="Left" Width="184" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
                <TextBlock Text="Elementos" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                <UniformGrid Columns="2">
                    <Button Style="{StaticResource ToolTile}" Tag="Lampada" Click="AddElement_Click" ToolTip="Acende conforme um bit (sensor, motor ligado, falha)">
                        <StackPanel><Image Source="{StaticResource IconLampada}" Width="26" Height="26" /><TextBlock Text="Lâmpada" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolTile}" Tag="Botao" Click="AddElement_Click" ToolTip="Liga/desliga um bit ou escreve um valor fixo">
                        <StackPanel><Image Source="{StaticResource IconBotao}" Width="26" Height="26" /><TextBlock Text="Botão" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolTile}" Tag="Valor" Click="AddElement_Click" ToolTip="Mostra um valor grande, com unidade, tendência e alarme">
                        <StackPanel><Image Source="{StaticResource IconValor}" Width="26" Height="26" /><TextBlock Text="Mostrador" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolTile}" Tag="Setpoint" Click="AddElement_Click" ToolTip="Campo para digitar e enviar um valor">
                        <StackPanel><Image Source="{StaticResource IconSetpoint}" Width="26" Height="26" /><TextBlock Text="Setpoint" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolTile}" Tag="Barra" Click="AddElement_Click" ToolTip="Barra de nível com régua e marcas de alarme">
                        <StackPanel><Image Source="{StaticResource IconBarra}" Width="26" Height="26" /><TextBlock Text="Barra" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolTile}" Tag="Texto" Click="AddElement_Click" ToolTip="Título, nome de área, observação">
                        <StackPanel><Image Source="{StaticResource IconTexto}" Width="26" Height="26" /><TextBlock Text="Texto" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                </UniformGrid>
                <TextBlock Text="Símbolos" Style="{StaticResource SectionTitle}" Margin="0,8,0,8" />
                <UniformGrid Columns="2">
                    <Button Style="{StaticResource ToolTile}" Tag="Motor" Click="AddElement_Click" ToolTip="Gira quando o bit está ligado">
                        <StackPanel><Image Source="{StaticResource IconMotor}" Width="26" Height="26" /><TextBlock Text="Motor" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolTile}" Tag="Bomba" Click="AddElement_Click" ToolTip="Rotor gira quando o bit está ligado">
                        <StackPanel><Image Source="{StaticResource IconBomba}" Width="26" Height="26" /><TextBlock Text="Bomba" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolTile}" Tag="Valvula" Click="AddElement_Click" ToolTip="Aberta ou fechada conforme o bit">
                        <StackPanel><Image Source="{StaticResource IconValvula}" Width="26" Height="26" /><TextBlock Text="Válvula" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolTile}" Tag="Tanque" Click="AddElement_Click" ToolTip="Nível com régua e limite de alarme (mín/máx)">
                        <StackPanel><Image Source="{StaticResource IconTanque}" Width="26" Height="26" /><TextBlock Text="Tanque" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolTile}" Tag="Esteira" Click="AddElement_Click" ToolTip="A correia anda quando o bit está ligado">
                        <StackPanel><Image Source="{StaticResource IconEsteira}" Width="26" Height="26" /><TextBlock Text="Esteira" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolTile}" Tag="Sinaleiro" Click="AddElement_Click" ToolTip="Torre de luz: verde, amarelo e vermelho (um bit para cada)">
                        <StackPanel><Image Source="{StaticResource IconSinaleiro}" Width="26" Height="26" /><TextBlock Text="Sinaleiro" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                </UniformGrid>
                <TextBlock Text="Supervisão" Style="{StaticResource SectionTitle}" Margin="0,8,0,8" />
                <UniformGrid Columns="2">
                    <Button Style="{StaticResource ToolTile}" Tag="Tubo" Click="AddElement_Click" ToolTip="Trecho de cano: o fluido anda quando o bit está ligado. Junte trechos para fazer curvas">
                        <StackPanel><Image Source="{StaticResource IconTubo}" Width="26" Height="26" /><TextBlock Text="Tubulação" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolTile}" Tag="Estados" Click="AddElement_Click" ToolTip="Traduz números em texto e cor: 0 = Parada, 1 = Pronta, 2 = Em ciclo, 3 = Falha">
                        <StackPanel><Image Source="{StaticResource IconEstados}" Width="26" Height="26" /><TextBlock Text="Estados" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolTile}" Tag="Medidor" Click="AddElement_Click" ToolTip="Mostrador de ponteiro com escala e faixas de alarme">
                        <StackPanel><Image Source="{StaticResource IconMedidor}" Width="26" Height="26" /><TextBlock Text="Medidor" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolTile}" Tag="Tendencia" Click="AddElement_Click" ToolTip="Gráfico dos últimos valores com linha de alarme">
                        <StackPanel><Image Source="{StaticResource IconTendencia}" Width="26" Height="26" /><TextBlock Text="Tendência" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolTile}" Tag="Painel" Click="AddElement_Click" ToolTip="Retângulo para agrupar uma área (ex.: Estação 20). Use 'Enviar para trás'">
                        <StackPanel><Image Source="{StaticResource IconPainel}" Width="26" Height="26" /><TextBlock Text="Painel" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolTile}" Tag="Imagem" Click="AddElement_Click" ToolTip="Logo, ícone ou foto (PNG/JPG), guardada no projeto">
                        <StackPanel><Image Source="{StaticResource IconImagem}" Width="26" Height="26" /><TextBlock Text="Imagem" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" /></StackPanel>
                    </Button>
                </UniformGrid>
                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="11.5"
                           Text="Clique para adicionar. Arraste para mover; arraste no fundo para selecionar vários; Ctrl+clique soma à seleção. Canto azul = tamanho. Ctrl+Z desfaz · Ctrl+C/V copia · Ctrl+D duplica · Del apaga · setas movem 1 px (Shift: 10)." />
            </StackPanel></ScrollViewer>
        </Border>

        <!-- ===== Propriedades (modo edição) ===== -->
        <Border x:Name="PropertiesHost" DockPanel.Dock="Right" Width="300" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <TextBlock x:Name="NoSelectionText" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="16"
                           Text="Selecione um elemento na tela para editar o texto, a variável ligada e a aparência." />
                <StackPanel x:Name="MultiSelectPanel" Margin="16" Visibility="Collapsed">
                    <TextBlock x:Name="MultiSelectText" Style="{StaticResource SectionTitle}" FontSize="14" />
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Arraste qualquer um para mover todos. Use a barra de cima para alinhar e distribuir, ou Del / Ctrl+C / Ctrl+D." />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Duplicar" Click="Duplicate_Click" Margin="0,0,6,6" />
                        <Button Content="Travar" Click="LockAll_Click" Margin="0,0,6,6" />
                        <Button Content="Destravar" Click="UnlockAll_Click" Margin="0,0,6,6" />
                        <Button Content="Excluir" Click="Delete_Click" Margin="0,0,0,6" Foreground="#CF222E" />
                    </WrapPanel>
                </StackPanel>
                <ScrollViewer x:Name="PropertiesPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="14,12,14,16">
                        <TextBlock Text="{Binding KindName}" Style="{StaticResource SectionTitle}" FontSize="14" />

                        <TextBlock Text="Texto / título" Style="{StaticResource PropLabel}" />
                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Tamanho da fonte" Style="{StaticResource PropLabel}" />
                        <TextBox Text="{Binding FontSize}" Width="70" HorizontalAlignment="Left" />

                        <!-- Variável -->
                        <StackPanel Visibility="{Binding HasBinding, Converter={StaticResource B2V}}">
                            <TextBlock Text="Variável" Style="{StaticResource PropGroup}" />
                            <Border Visibility="{Binding IsLinked, Converter={StaticResource B2V}}" Background="#DDF4FF" BorderBrush="#54AEFF"
                                    BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding LinkText}" TextWrapping="Wrap" Foreground="#0A3069" FontSize="11.5" />
                                    <Button Content="Desligar do item" HorizontalAlignment="Left" Margin="0,6,0,0" Click="Unlink_Click"
                                            ToolTip="O elemento passa a ler a variável direto e a usar unidade/alarme próprios (sem a escala do item)" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Ligar a um item da Data Access View" Style="{StaticResource PropLabel}" />
                            <ComboBox x:Name="WatchBox" SelectionChanged="WatchBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                            <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#8C959F">
                                                <Run Text="{Binding ConnectionName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding AddressText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <StackPanel IsEnabled="{Binding IsNotLinked}">
                            <TextBlock Text="Conexão" Style="{StaticResource PropLabel}" />
                            <ComboBox x:Name="ConnectionBox" SelectedItem="{Binding ConnectionName}" />
                            <TextBlock Text="Endereço" Style="{StaticResource PropLabel}" />
                            <TextBox Text="{Binding Address}" FontFamily="Consolas" ToolTip="Ex.: DB1.DBX0.0, DB1.DBD4, HR:100, CO:3, ns=2;s=Tag, Programa.Tag" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsStackLight, Converter={StaticResource B2V}}">
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Text="O endereço acima é a luz verde. Bits das outras luzes (vazio = não usa):" />
                                <TextBlock Text="Endereço da luz amarela" Style="{StaticResource PropLabel}" />
                                <TextBox Text="{Binding Address2}" FontFamily="Consolas" />
                                <TextBlock Text="Endereço da luz vermelha" Style="{StaticResource PropLabel}" />
                                <TextBox Text="{Binding Address3}" FontFamily="Consolas" />
                            </StackPanel>
                            <Grid Margin="0,0,0,0" IsEnabled="{Binding IsNotLinked}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="50" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Tipo" Style="{StaticResource PropLabel}" />
                                    <ComboBox x:Name="TypeBox" SelectedItem="{Binding DataType}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ordem" Style="{StaticResource PropLabel}" />
                                    <ComboBox x:Name="OrderBox" SelectedItem="{Binding ByteOrder}" ToolTip="Só para valores de 32/64 bits no Modbus" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Tam." Style="{StaticResource PropLabel}" />
                                    <TextBox Text="{Binding Length}" ToolTip="Strings: caracteres (S7) ou registradores (Modbus)" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Tubulação -->
                        <StackPanel Visibility="{Binding ShowFlowReverse, Converter={StaticResource B2V}}">
                            <TextBlock Text="Tubulação" Style="{StaticResource PropGroup}" />
                            <CheckBox Content="Fluxo no sentido contrário" IsChecked="{Binding FlowReverse}" Margin="0,6,0,0"
                                      ToolTip="Normal: esquerda → direita (horizontal) ou cima → baixo (vertical)" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Ligue no bit da bomba/válvula: com o bit ligado o fluido anda. Para curvas, junte um trecho horizontal e um vertical." />
                        </StackPanel>

                        <!-- Estados -->
                        <StackPanel Visibility="{Binding ShowStates, Converter={StaticResource B2V}}">
                            <TextBlock Text="Estados" Style="{StaticResource PropGroup}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,4"
                                       Text="Uma linha por estado: valor = texto = cor. Cores: Verde, Vermelho, Amarelo, Laranja, Azul, Roxo, Cinza, Preto, Branco." />
                            <TextBox Text="{Binding States}" AcceptsReturn="True" TextWrapping="NoWrap" Height="110" FontFamily="Consolas"
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>

                        <!-- Imagem -->
                        <StackPanel Visibility="{Binding ShowImagePicker, Converter={StaticResource B2V}}">
                            <TextBlock Text="Imagem" Style="{StaticResource PropGroup}" />
                            <Button Content="Escolher imagem..." HorizontalAlignment="Left" Margin="0,6,0,0" Click="ElementImage_Click" />
                        </StackPanel>

                        <!-- Botão -->
                        <StackPanel Visibility="{Binding ShowButtonMode, Converter={StaticResource B2V}}">
                            <TextBlock Text="Ação do botão" Style="{StaticResource PropGroup}" />
                            <ComboBox x:Name="ButtonModeBox" Margin="0,6,0,0" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding ButtonMode}" />
                            <StackPanel Visibility="{Binding ShowWriteValue, Converter={StaticResource B2V}}">
                                <TextBlock Text="Valor a escrever" Style="{StaticResource PropLabel}" />
                                <TextBox Text="{Binding WriteValue}" Width="120" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowTargetScreen, Converter={StaticResource B2V}}">
                                <TextBlock Text="Tela de destino" Style="{StaticResource PropLabel}" />
                                <ComboBox x:Name="TargetScreenBox" SelectedItem="{Binding TargetScreen}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Cores -->
                        <StackPanel Visibility="{Binding ShowColors, Converter={StaticResource B2V}}">
                            <TextBlock Text="Cores" Style="{StaticResource PropGroup}" />
                            <TextBlock Text="{Binding OnColorLabel}" Style="{StaticResource PropLabel}" />
                            <ComboBox x:Name="OnColorBox" ItemTemplate="{StaticResource ColorItem}" SelectedValuePath="Name" SelectedValue="{Binding OnColor}" />
                            <StackPanel Visibility="{Binding ShowOffColor, Converter={StaticResource B2V}}">
                                <TextBlock Text="{Binding OffColorLabel}" Style="{StaticResource PropLabel}" />
                                <ComboBox x:Name="OffColorBox" ItemTemplate="{StaticResource ColorItem}" SelectedValuePath="Name" SelectedValue="{Binding OffColor}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Formato -->
                        <StackPanel Visibility="{Binding ShowUnit, Converter={StaticResource B2V}}">
                            <TextBlock Text="Formato" Style="{StaticResource PropGroup}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Unidade" Style="{StaticResource PropLabel}" />
                                    <TextBox Text="{Binding Unit}" ToolTip="Vazio = usa a unidade do item ligado (se houver)" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Casas decimais" Style="{StaticResource PropLabel}" />
                                    <TextBox Text="{Binding Decimals}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowRange, Converter={StaticResource B2V}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Mínimo" Style="{StaticResource PropLabel}" />
                                    <TextBox Text="{Binding Min}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Máximo" Style="{StaticResource PropLabel}" />
                                    <TextBox Text="{Binding Max}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowOwnAlarm, Converter={StaticResource B2V}}">
                            <TextBlock Text="Alarme (vazio = desligado)" Style="{StaticResource PropGroup}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Alto (&gt;)" Style="{StaticResource PropLabel}" />
                                    <TextBox Text="{Binding AlarmHighText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Baixo (&lt;)" Style="{StaticResource PropLabel}" />
                                    <TextBox Text="{Binding AlarmLowText}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Comportamento -->
                        <TextBlock Text="Comportamento" Style="{StaticResource PropGroup}" />
                        <CheckBox Content="Abrir detalhes ao clicar (faceplate)" IsChecked="{Binding Faceplate}" Margin="0,6,0,0"
                                  Visibility="{Binding ShowFaceplateOption, Converter={StaticResource B2V}}"
                                  ToolTip="No modo Executar, clicar abre uma janela com valor, qualidade, variável e erro (só leitura)" />
                        <TextBlock Text="Piscar" Style="{StaticResource PropLabel}" />
                        <ComboBox x:Name="BlinkBox" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Blink}" />
                        <TextBlock Text="Mostrar" Style="{StaticResource PropLabel}" />
                        <ComboBox x:Name="VisibleWhenBox" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding VisibleWhen}"
                                  ToolTip="No modo Executar, o elemento só aparece quando a condição é atendida (ex.: mensagem de falha)" />
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VisibleWhen}" Value="Sempre">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Bit da condição" Style="{StaticResource PropLabel}" />
                            <TextBox Text="{Binding VisibilityAddress}" FontFamily="Consolas" ToolTip="Ex.: DB16.DBX0.4 · usa a mesma conexão do elemento" />
                            <StackPanel Visibility="{Binding HasBinding, Converter={StaticResource InverseB2V}}">
                                <TextBlock Text="Conexão do bit" Style="{StaticResource PropLabel}" />
                                <ComboBox x:Name="VisibilityConnectionBox" SelectedItem="{Binding ConnectionName}" />
                            </StackPanel>
                        </StackPanel>
                        <CheckBox Content="Travar posição e tamanho" IsChecked="{Binding Locked}" Margin="0,10,0,0"
                                  ToolTip="Evita mover sem querer (ex.: painel de fundo, imagem)" />

                        <!-- Posição -->
                        <TextBlock Text="Posição e tamanho" Style="{StaticResource PropGroup}" />
                        <UniformGrid Columns="4" Margin="0,6,0,0">
                            <StackPanel Margin="0,0,4,0"><TextBlock Text="X" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding X}" /></StackPanel>
                            <StackPanel Margin="0,0,4,0"><TextBlock Text="Y" Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Y}" /></StackPanel>
                            <StackPanel Margin="0,0,4,0"><TextBlock Text="Larg." Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Width}" /></StackPanel>
                            <StackPanel><TextBlock Text="Alt." Foreground="{StaticResource MutedBrush}" /><TextBox Text="{Binding Height}" /></StackPanel>
                        </UniformGrid>

                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="Duplicar" Click="Duplicate_Click" Margin="0,0,6,6" />
                            <Button Content="Trazer à frente" Click="BringFront_Click" Margin="0,0,6,6" />
                            <Button Content="Enviar para trás" Click="SendBack_Click" Margin="0,0,6,6" />
                            <Button Content="Excluir" Click="Delete_Click" Margin="0,0,0,6" Foreground="#CF222E" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ===== Área da tela ===== -->
        <Grid>
        <ScrollViewer x:Name="SurfaceScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="16">
          <Viewbox x:Name="FitBox" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel x:Name="Stage">
              <StackPanel.LayoutTransform>
                  <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
              </StackPanel.LayoutTransform>
              <!-- Cabeçalho da tela no modo Executar (nome + relógio), como num SCADA -->
              <Border x:Name="RunHeader" Visibility="Collapsed" Padding="14,8" Background="#1E2D3D">
                  <DockPanel>
                      <TextBlock x:Name="ClockText" DockPanel.Dock="Right" Foreground="White" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center" />
                      <TextBlock x:Name="HeaderTitle" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                  </DockPanel>
              </Border>
              <Border x:Name="SurfaceFrame" BorderBrush="#D0D7DE" BorderThickness="1">
                <Grid x:Name="Surface" Background="White" ClipToBounds="True"
                      MouseLeftButtonDown="Surface_MouseLeftButtonDown" MouseMove="Surface_MouseMove" MouseLeftButtonUp="Surface_MouseLeftButtonUp">
                    <!-- imagem de fundo (sinóptico) -->
                    <Image x:Name="BgImage" IsHitTestVisible="False" Stretch="Uniform" />
                    <!-- grade de pontos (só na edição) -->
                    <Rectangle x:Name="GridDots" IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <!-- o quadrado transparente de 20×20 define o tamanho da célula; sem ele o ponto é esticado e pinta tudo de cinza -->
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="Transparent">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,20,20" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                        <GeometryDrawing Brush="#C2CAD3">
                                            <GeometryDrawing.Geometry>
                                                <RectangleGeometry Rect="0,0,1.5,1.5" />
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <ItemsControl x:Name="ElementsHost">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding X}" />
                                <Setter Property="Canvas.Top" Value="{Binding Y}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Root" Width="{Binding Width}" Height="{Binding Height}" ToolTip="{Binding StatusTip}"
                                      MouseLeftButtonUp="Element_RunClick">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsWinCC}" Value="True">
                                                    <Setter Property="TextElement.FontFamily" Value="Arial" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHiddenByCondition}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsClickable}" Value="True">
                                                    <Setter Property="Cursor" Value="Hand" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <!-- Painel / retângulo (fica atrás do resto quando enviado para trás) -->
                                    <Border Visibility="{Binding IsPanel, Converter={StaticResource B2V}}" Background="{Binding PanelBrush}"
                                            BorderBrush="#57606A" BorderThickness="1.5" CornerRadius="4" Padding="10,6">
                                        <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontWeight="SemiBold" Foreground="#24292F"
                                                   HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    </Border>

                                    <!-- Imagem -->
                                    <Image Visibility="{Binding IsImage, Converter={StaticResource B2V}}" Source="{Binding ImageSource}" Stretch="Uniform" />

                                    <!-- Tubulação: trecho horizontal ou vertical, fluido animado -->
                                    <Border Visibility="{Binding IsPipe, Converter={StaticResource B2V}}" Background="#C9CED4" BorderBrush="#57606A"
                                            BorderThickness="1.5" CornerRadius="3" ClipToBounds="True">
                                        <Grid>
                                            <Line x:Name="FlowH" Visibility="{Binding IsHorizontalBar, Converter={StaticResource B2V}}"
                                                  X1="0" Y1="0" X2="{Binding Width}" Y2="0" VerticalAlignment="Center"
                                                  Stroke="{Binding FlowBrush}" StrokeThickness="{Binding PipeThickness}" StrokeDashArray="2 1" />
                                            <Line x:Name="FlowV" Visibility="{Binding IsVerticalBar, Converter={StaticResource B2V}}"
                                                  X1="0" Y1="0" X2="0" Y2="{Binding Height}" HorizontalAlignment="Center"
                                                  Stroke="{Binding FlowBrush}" StrokeThickness="{Binding PipeThickness}" StrokeDashArray="2 1" />
                                        </Grid>
                                    </Border>

                                    <!-- Cartão (lâmpada, mostrador, setpoint, barra) -->
                                    <Border Visibility="{Binding HasCard, Converter={StaticResource B2V}}" BorderThickness="1" Padding="10,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="White" />
                                                <Setter Property="BorderBrush" Value="#D0D7DE" />
                                                <Setter Property="CornerRadius" Value="8" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWinCC}" Value="True">
                                                        <Setter Property="Background" Value="#E4E7EA" />
                                                        <Setter Property="BorderBrush" Value="#7A848E" />
                                                        <Setter Property="CornerRadius" Value="0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsIsa}" Value="True">
                                                        <Setter Property="Background" Value="#E8E9EB" />
                                                        <Setter Property="BorderBrush" Value="#B5B9BE" />
                                                        <Setter Property="CornerRadius" Value="4" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <!-- Lâmpada -->
                                            <DockPanel Visibility="{Binding IsLamp, Converter={StaticResource B2V}}">
                                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Text}" FontSize="{Binding FontSize}" HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                <Viewbox>
                                                    <Grid Width="40" Height="40">
                                                        <Ellipse Fill="{Binding LampBrush}" Stroke="#57606A" StrokeThickness="1.5" />
                                                        <Ellipse Margin="8,5,16,22" Fill="White" Opacity="0.35" />
                                                    </Grid>
                                                </Viewbox>
                                            </DockPanel>

                                            <!-- Mostrador -->
                                            <DockPanel Visibility="{Binding IsValue, Converter={StaticResource B2V}}">
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="#57606A" TextTrimming="CharacterEllipsis" />
                                                <Border DockPanel.Dock="Bottom" Style="{StaticResource AlarmBadge}" Margin="0,4,0,0"
                                                        Visibility="{Binding HasAlarm, Converter={StaticResource B2V}}">
                                                    <TextBlock Text="{Binding AlarmBadgeText}" Style="{StaticResource AlarmBadgeText}" />
                                                </Border>
                                                <Border VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <!-- campo de E/S branco, como no WinCC -->
                                                                <DataTrigger Binding="{Binding IsWinCC}" Value="True">
                                                                    <Setter Property="Background" Value="White" />
                                                                    <Setter Property="BorderBrush" Value="#7A848E" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Setter Property="Padding" Value="6,0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DisplayText}" FontSize="{Binding BigFontSize}" FontWeight="SemiBold" Foreground="{Binding ValueForeground}" />
                                                            <TextBlock Text="{Binding UnitText}" FontSize="{Binding FontSize}" Foreground="#6E7781" Margin="6,0,0,4" VerticalAlignment="Bottom" />
                                                            <TextBlock Text="{Binding TrendArrow}" FontSize="{Binding FontSize}" FontWeight="Bold" Foreground="{Binding ValueForeground}"
                                                                       Margin="4,0,0,4" VerticalAlignment="Bottom" ToolTip="Tendência: subindo (↑) ou descendo (↓)" />
                                                        </StackPanel>
                                                    </Viewbox>
                                                </Border>
                                            </DockPanel>

                                            <!-- Setpoint -->
                                            <DockPanel Visibility="{Binding IsSetpoint, Converter={StaticResource B2V}}">
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="#57606A" TextTrimming="CharacterEllipsis" />
                                                <TextBlock DockPanel.Dock="Top" Foreground="#8C959F" FontSize="11" Margin="0,2,0,6">
                                                    <Run Text="Atual: " /><Run Text="{Binding DisplayText, Mode=OneWay}" FontFamily="Consolas" /><Run Text=" " /><Run Text="{Binding UnitText, Mode=OneWay}" />
                                                </TextBlock>
                                                <DockPanel VerticalAlignment="Top">
                                                    <Button DockPanel.Dock="Right" Content="Enviar" Margin="6,0,0,0" Click="SendSetpoint_Click" IsEnabled="{Binding IsRunMode}" />
                                                    <TextBox Text="{Binding SetpointText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="{Binding FontSize}"
                                                             KeyDown="Setpoint_KeyDown" IsEnabled="{Binding IsRunMode}" />
                                                </DockPanel>
                                            </DockPanel>

                                            <!-- Barra: régua com mínimo/meio/máximo e marcas dos limites de alarme -->
                                            <DockPanel Visibility="{Binding IsBar, Converter={StaticResource B2V}}">
                                                <DockPanel DockPanel.Dock="Top">
                                                    <TextBlock DockPanel.Dock="Right" Foreground="{Binding ValueForeground}" FontWeight="SemiBold">
                                                        <Run Text="{Binding DisplayText, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding UnitText, Mode=OneWay}" Foreground="#6E7781" FontWeight="Normal" /><Run Text=" " /><Run Text="{Binding TrendArrow, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="#57606A" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <Border DockPanel.Dock="Bottom" Style="{StaticResource AlarmBadge}" Margin="0,4,0,0"
                                                        Visibility="{Binding HasAlarm, Converter={StaticResource B2V}}">
                                                    <TextBlock Text="{Binding AlarmBadgeText}" Style="{StaticResource AlarmBadgeText}" />
                                                </Border>
                                                <Grid Margin="0,6,0,0">
                                                    <!-- horizontal -->
                                                    <Grid Visibility="{Binding IsHorizontalBar, Converter={StaticResource B2V}}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <ProgressBar Orientation="Horizontal" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Numeric, Mode=OneWay}"
                                                                     Foreground="{Binding BarBrush}" Background="{Binding TrackBrush}" BorderBrush="#AFB8C1" BorderThickness="1" />
                                                        <Grid IsHitTestVisible="False" Visibility="{Binding HasHighMarker, Converter={StaticResource B2V}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding HighBefore}" />
                                                                <ColumnDefinition Width="{Binding HighAfter}" />
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle Grid.Column="1" Width="2" HorizontalAlignment="Left" Margin="-1,-3" Fill="#CF222E" ToolTip="Limite de alarme alto" />
                                                        </Grid>
                                                        <Grid IsHitTestVisible="False" Visibility="{Binding HasLowMarker, Converter={StaticResource B2V}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="{Binding LowBefore}" />
                                                                <ColumnDefinition Width="{Binding LowAfter}" />
                                                            </Grid.ColumnDefinitions>
                                                            <Rectangle Grid.Column="1" Width="2" HorizontalAlignment="Left" Margin="-1,-3" Fill="#BF8700" ToolTip="Limite de alarme baixo" />
                                                        </Grid>
                                                        <Grid Grid.Row="1" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding MinText}" FontSize="9" Foreground="#6E7781" HorizontalAlignment="Left" />
                                                            <TextBlock Text="{Binding MidText}" FontSize="9" Foreground="#6E7781" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding MaxText}" FontSize="9" Foreground="#6E7781" HorizontalAlignment="Right" />
                                                        </Grid>
                                                    </Grid>
                                                    <!-- vertical -->
                                                    <Grid Visibility="{Binding IsVerticalBar, Converter={StaticResource B2V}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ProgressBar Orientation="Vertical" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Numeric, Mode=OneWay}"
                                                                     Foreground="{Binding BarBrush}" Background="{Binding TrackBrush}" BorderBrush="#AFB8C1" BorderThickness="1" />
                                                        <Grid IsHitTestVisible="False" Visibility="{Binding HasHighMarker, Converter={StaticResource B2V}}">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="{Binding HighAfter}" />
                                                                <RowDefinition Height="{Binding HighBefore}" />
                                                            </Grid.RowDefinitions>
                                                            <Rectangle Height="2" VerticalAlignment="Bottom" Margin="-3,0,-3,-1" Fill="#CF222E" ToolTip="Limite de alarme alto" />
                                                        </Grid>
                                                        <Grid IsHitTestVisible="False" Visibility="{Binding HasLowMarker, Converter={StaticResource B2V}}">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="{Binding LowAfter}" />
                                                                <RowDefinition Height="{Binding LowBefore}" />
                                                            </Grid.RowDefinitions>
                                                            <Rectangle Height="2" VerticalAlignment="Bottom" Margin="-3,0,-3,-1" Fill="#BF8700" ToolTip="Limite de alarme baixo" />
                                                        </Grid>
                                                        <Grid Grid.Column="1" Margin="4,0,0,0">
                                                            <TextBlock Text="{Binding MaxText}" FontSize="9" Foreground="#6E7781" VerticalAlignment="Top" />
                                                            <TextBlock Text="{Binding MidText}" FontSize="9" Foreground="#6E7781" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding MinText}" FontSize="9" Foreground="#6E7781" VerticalAlignment="Bottom" />
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </DockPanel>

                                            <!-- Indicador de estados -->
                                            <DockPanel Visibility="{Binding IsStates, Converter={StaticResource B2V}}">
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="#57606A" TextTrimming="CharacterEllipsis" />
                                                <Border Background="{Binding StateBrush}" CornerRadius="4" Margin="0,6,0,0" Padding="8,4">
                                                    <Viewbox StretchDirection="DownOnly">
                                                        <TextBlock Text="{Binding StateText}" Foreground="White" FontWeight="Bold" FontSize="{Binding BigFontSize}" />
                                                    </Viewbox>
                                                </Border>
                                            </DockPanel>

                                            <!-- Medidor de ponteiro -->
                                            <DockPanel Visibility="{Binding IsGauge, Converter={StaticResource B2V}}">
                                                <TextBlock DockPanel.Dock="Top" Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="#57606A"
                                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                                <Viewbox>
                                                    <Canvas Width="120" Height="118">
                                                        <!-- arco, faixas de atenção/alarme e marcas da escala -->
                                                        <Path Data="M 24.6,95.4 A 50,50 0 1 1 95.4,95.4" Stroke="{Binding GaugeTrackBrush}" StrokeThickness="10" />
                                                        <Path Data="{Binding GaugeLowWarn}" Stroke="#E0B53A" StrokeThickness="10" />
                                                        <Path Data="{Binding GaugeLowBand}" Stroke="#CF222E" StrokeThickness="10" />
                                                        <Path Data="{Binding GaugeHighWarn}" Stroke="#E0B53A" StrokeThickness="10" />
                                                        <Path Data="{Binding GaugeHighBand}" Stroke="#CF222E" StrokeThickness="10" />
                                                        <Path Data="{Binding GaugeTicks}" Stroke="#57606A" StrokeThickness="1.2" />
                                                        <TextBlock Canvas.Left="10" Canvas.Top="98" Width="40" Text="{Binding MinText}" FontSize="8.5" Foreground="#6E7781" />
                                                        <TextBlock Canvas.Left="0" Canvas.Top="20" Width="120" TextAlignment="Center" Text="{Binding MidText}" FontSize="8.5" Foreground="#6E7781" />
                                                        <TextBlock Canvas.Left="70" Canvas.Top="98" Width="40" TextAlignment="Right" Text="{Binding MaxText}" FontSize="8.5" Foreground="#6E7781" />
                                                        <!-- ponteiro -->
                                                        <Line X1="60" Y1="60" X2="60" Y2="22" Stroke="{Binding BarBrush}" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Triangle"
                                                              RenderTransform="{Binding NeedleAngle, Converter={StaticResource NeedleRotate}}" />
                                                        <Ellipse Canvas.Left="54" Canvas.Top="54" Width="12" Height="12" Fill="#24292F" />
                                                        <!-- valor -->
                                                        <TextBlock Canvas.Left="0" Canvas.Top="74" Width="120" TextAlignment="Center" Foreground="{Binding ValueForeground}">
                                                            <Run Text="{Binding DisplayText, Mode=OneWay}" FontWeight="Bold" FontSize="15" /><Run Text=" " /><Run Text="{Binding UnitText, Mode=OneWay}" FontSize="9" Foreground="#6E7781" />
                                                        </TextBlock>
                                                        <Border Canvas.Left="0" Canvas.Top="100" Width="120" Visibility="{Binding HasAlarm, Converter={StaticResource B2V}}">
                                                            <Border Style="{StaticResource AlarmBadge}" HorizontalAlignment="Center" Padding="4,0">
                                                                <TextBlock Text="{Binding AlarmBadgeText}" Style="{StaticResource AlarmBadgeText}" FontSize="8" />
                                                            </Border>
                                                        </Border>
                                                    </Canvas>
                                                </Viewbox>
                                            </DockPanel>

                                            <!-- Mini tendência -->
                                            <DockPanel Visibility="{Binding IsTrend, Converter={StaticResource B2V}}">
                                                <DockPanel DockPanel.Dock="Top">
                                                    <TextBlock DockPanel.Dock="Right" FontWeight="Bold" Foreground="{Binding ValueForeground}">
                                                        <Run Text="{Binding DisplayText, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding UnitText, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" Foreground="#57606A" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <Grid Margin="0,6,0,0" ClipToBounds="True">
                                                    <!-- grade -->
                                                    <UniformGrid Rows="4" IsHitTestVisible="False">
                                                        <Border BorderBrush="#E1E4E8" BorderThickness="0,1,0,0" />
                                                        <Border BorderBrush="#E1E4E8" BorderThickness="0,1,0,0" />
                                                        <Border BorderBrush="#E1E4E8" BorderThickness="0,1,0,0" />
                                                        <Border BorderBrush="#E1E4E8" BorderThickness="0,1,0,1" />
                                                    </UniformGrid>
                                                    <Canvas>
                                                        <Line X1="0" X2="{Binding TrendWidth}" Y1="{Binding TrendHighY}" Y2="{Binding TrendHighY}" Stroke="#CF222E" StrokeThickness="1.2"
                                                              StrokeDashArray="5 3" Visibility="{Binding HasTrendHigh, Converter={StaticResource B2V}}" />
                                                        <Line X1="0" X2="{Binding TrendWidth}" Y1="{Binding TrendLowY}" Y2="{Binding TrendLowY}" Stroke="#BF8700" StrokeThickness="1.2"
                                                              StrokeDashArray="5 3" Visibility="{Binding HasTrendLow, Converter={StaticResource B2V}}" />
                                                        <Polyline Points="{Binding TrendPoints}" Stroke="{Binding TrendBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                                    </Canvas>
                                                    <!-- escala -->
                                                    <TextBlock Text="{Binding TrendTopText}" FontSize="8.5" Foreground="#6E7781" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,2,0" />
                                                    <TextBlock Text="{Binding TrendBottomText}" FontSize="8.5" Foreground="#6E7781" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,1" />
                                                </Grid>
                                            </DockPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Símbolos industriais (traço de P&ID; cor pelo estado, selo de estado embaixo) -->
                                    <DockPanel Visibility="{Binding IsSymbol, Converter={StaticResource B2V}}">
                                        <Border DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,3,0,0" Padding="7,1" CornerRadius="3"
                                                Background="{Binding SymbolChipBrush}" Visibility="{Binding ShowStateChip, Converter={StaticResource B2V}}">
                                            <TextBlock Text="{Binding SymbolStateText}" Foreground="{Binding SymbolChipForeground}" FontSize="9.5" FontWeight="Bold" />
                                        </Border>
                                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Text}" FontSize="{Binding FontSize}" FontWeight="SemiBold" Foreground="#24292F"
                                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                   Visibility="{Binding HasCaption, Converter={StaticResource B2V}}" />
                                        <Grid>
                                            <!-- Motor: carcaça aletada, caixa de ligação, eixo e base; o rotor gira ligado -->
                                            <Viewbox Visibility="{Binding IsMotor, Converter={StaticResource B2V}}">
                                                <Canvas Width="100" Height="86">
                                                    <Rectangle Canvas.Left="34" Canvas.Top="4" Width="26" Height="12" RadiusX="2" RadiusY="2" Fill="#9AA0A6" Stroke="#3E444A" StrokeThickness="1.5" />
                                                    <Path Data="M16,82 L26,70 L68,70 L78,82 Z" Fill="#9AA0A6" Stroke="#3E444A" StrokeThickness="1.5" StrokeLineJoin="Round" />
                                                    <Rectangle Canvas.Left="80" Canvas.Top="39" Width="16" Height="8" Fill="#9AA0A6" Stroke="#3E444A" StrokeThickness="1.5" />
                                                    <Rectangle Canvas.Left="4" Canvas.Top="22" Width="12" Height="42" RadiusX="3" RadiusY="3" Fill="#9AA0A6" Stroke="#3E444A" StrokeThickness="1.5" />
                                                    <Rectangle Canvas.Left="12" Canvas.Top="16" Width="68" Height="54" RadiusX="6" RadiusY="6" Fill="{Binding SymbolBrush}" Stroke="#24292F" StrokeThickness="2.5" />
                                                    <Path Data="M18,25 L74,25 M18,33 L74,33 M18,53 L74,53 M18,61 L74,61" Stroke="#24292F" StrokeThickness="1.2" Opacity="0.35" />
                                                    <Ellipse Canvas.Left="33" Canvas.Top="30" Width="26" Height="26" Fill="White" Stroke="#24292F" StrokeThickness="2" />
                                                    <Path x:Name="MotorRotor" Canvas.Left="33" Canvas.Top="30" Width="26" Height="26" RenderTransformOrigin="0.5,0.5" Fill="#3E444A"
                                                          Data="M13,13 L13,3 A10,10 0 0 1 21.66,8 Z M13,13 L21.66,18 A10,10 0 0 1 13,23 Z M13,13 L4.34,18 A10,10 0 0 1 4.34,8 Z">
                                                        <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                                                    </Path>
                                                    <Ellipse Canvas.Left="43" Canvas.Top="40" Width="6" Height="6" Fill="#24292F" />
                                                </Canvas>
                                            </Viewbox>

                                            <!-- Bomba centrífuga (P&ID): sucção à esquerda, recalque tangente em cima; o rotor gira ligado -->
                                            <Viewbox Visibility="{Binding IsPump, Converter={StaticResource B2V}}">
                                                <Canvas Width="100" Height="94">
                                                    <Rectangle Canvas.Left="4" Canvas.Top="44" Width="22" Height="14" Fill="#9AA0A6" Stroke="#3E444A" StrokeThickness="1.5" />
                                                    <Rectangle Canvas.Left="2" Canvas.Top="40" Width="5" Height="22" Fill="#6E7781" />
                                                    <Rectangle Canvas.Left="50" Canvas.Top="14" Width="42" Height="14" Fill="#9AA0A6" Stroke="#3E444A" StrokeThickness="1.5" />
                                                    <Rectangle Canvas.Left="90" Canvas.Top="10" Width="5" Height="22" Fill="#6E7781" />
                                                    <Path Data="M24,90 L34,76 L66,76 L76,90 Z" Fill="#9AA0A6" Stroke="#3E444A" StrokeThickness="1.5" StrokeLineJoin="Round" />
                                                    <Ellipse Canvas.Left="20" Canvas.Top="21" Width="60" Height="60" Fill="{Binding SymbolBrush}" Stroke="#24292F" StrokeThickness="2.5" />
                                                    <Ellipse Canvas.Left="30" Canvas.Top="31" Width="40" Height="40" Fill="White" Opacity="0.55" />
                                                    <Path x:Name="PumpRotor" Canvas.Left="30" Canvas.Top="31" Width="40" Height="40" RenderTransformOrigin="0.5,0.5"
                                                          Stroke="#24292F" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Data="M20,20 Q27,9 20,3 M20,20 Q31,27 37,20 M20,20 Q13,31 20,37 M20,20 Q9,13 3,20">
                                                        <Path.RenderTransform><RotateTransform /></Path.RenderTransform>
                                                    </Path>
                                                    <Ellipse Canvas.Left="45" Canvas.Top="46" Width="10" Height="10" Fill="#24292F" />
                                                </Canvas>
                                            </Viewbox>

                                            <!-- Válvula gaveta com atuador pneumático -->
                                            <Viewbox Visibility="{Binding IsValve, Converter={StaticResource B2V}}">
                                                <Canvas Width="100" Height="82">
                                                    <Path Data="M26,26 A24,18 0 0 1 74,26 Z" Fill="#9AA0A6" Stroke="#3E444A" StrokeThickness="1.5" StrokeLineJoin="Round" />
                                                    <Rectangle Canvas.Left="24" Canvas.Top="25" Width="52" Height="4" Fill="#6E7781" />
                                                    <Line X1="50" Y1="29" X2="50" Y2="58" Stroke="#3E444A" StrokeThickness="3" />
                                                    <Rectangle Canvas.Left="2" Canvas.Top="40" Width="5" Height="36" Fill="#6E7781" />
                                                    <Rectangle Canvas.Left="93" Canvas.Top="40" Width="5" Height="36" Fill="#6E7781" />
                                                    <Path Data="M7,40 L50,58 L7,76 Z M93,40 L50,58 L93,76 Z" Fill="{Binding SymbolBrush}"
                                                          Stroke="#24292F" StrokeThickness="2.5" StrokeLineJoin="Round" />
                                                    <Ellipse Canvas.Left="46" Canvas.Top="54" Width="8" Height="8" Fill="#24292F" />
                                                </Canvas>
                                            </Viewbox>

                                            <!-- Tanque: vaso com régua, marca do limite de alarme e valor -->
                                            <Grid Visibility="{Binding IsTank, Converter={StaticResource B2V}}" Margin="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Width="16" Height="8" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-2,0,0" Fill="#9AA0A6" Stroke="#3E444A" StrokeThickness="1.2" />
                                                <Rectangle Width="16" Height="8" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-2" Fill="#9AA0A6" Stroke="#3E444A" StrokeThickness="1.2" />
                                                <Border Margin="0,5" CornerRadius="18" BorderBrush="#24292F" BorderThickness="2.5" Background="{Binding TrackBrush}">
                                                    <Grid ClipToBounds="True">
                                                        <Rectangle Fill="{Binding LiquidBrush}" Opacity="0.85" RenderTransformOrigin="0.5,1"
                                                                   RenderTransform="{Binding TankFraction, Converter={StaticResource FractionScaleY}}" />
                                                        <!-- marcas de 25, 50 e 75% -->
                                                        <UniformGrid Rows="4" IsHitTestVisible="False">
                                                            <Border />
                                                            <Border Width="12" HorizontalAlignment="Right" BorderBrush="#57606A" BorderThickness="0,1,0,0" />
                                                            <Border Width="18" HorizontalAlignment="Right" BorderBrush="#57606A" BorderThickness="0,1,0,0" />
                                                            <Border Width="12" HorizontalAlignment="Right" BorderBrush="#57606A" BorderThickness="0,1,0,0" />
                                                        </UniformGrid>
                                                        <!-- limite de alarme alto -->
                                                        <Grid IsHitTestVisible="False" Visibility="{Binding HasHighMarker, Converter={StaticResource B2V}}">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="{Binding HighAfter}" />
                                                                <RowDefinition Height="{Binding HighBefore}" />
                                                            </Grid.RowDefinitions>
                                                            <Border VerticalAlignment="Bottom" BorderBrush="#CF222E" BorderThickness="0,0,0,2" ToolTip="Limite de alarme alto" />
                                                        </Grid>
                                                        <Border Background="#E6FFFFFF" CornerRadius="3" Padding="6,1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                BorderBrush="#AFB8C1" BorderThickness="1">
                                                            <TextBlock FontWeight="Bold" Foreground="{Binding ValueForeground}">
                                                                <Run Text="{Binding DisplayText, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding UnitText, Mode=OneWay}" FontWeight="Normal" />
                                                            </TextBlock>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <Grid Grid.Column="1" Margin="4,12,0,12">
                                                    <TextBlock Text="{Binding MaxText}" FontSize="9" Foreground="#6E7781" VerticalAlignment="Top" />
                                                    <TextBlock Text="{Binding MidText}" FontSize="9" Foreground="#6E7781" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding MinText}" FontSize="9" Foreground="#6E7781" VerticalAlignment="Bottom" />
                                                </Grid>
                                            </Grid>

                                            <!-- Esteira: correia, tambores, roletes e pés; a correia anda ligada -->
                                            <Grid Visibility="{Binding IsConveyor, Converter={StaticResource B2V}}" Margin="2,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="10" />
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Rectangle RadiusX="16" RadiusY="16" Fill="#3E444A" Stroke="#24292F" StrokeThickness="2" />
                                                    <Rectangle x:Name="BeltPath" Margin="7" RadiusX="11" RadiusY="11" Stroke="{Binding BeltBrush}" StrokeThickness="3" StrokeDashArray="3 2" />
                                                    <UniformGrid Columns="5" Margin="40,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                        <Ellipse Width="8" Height="8" Fill="#9AA0A6" />
                                                        <Ellipse Width="8" Height="8" Fill="#9AA0A6" />
                                                        <Ellipse Width="8" Height="8" Fill="#9AA0A6" />
                                                        <Ellipse Width="8" Height="8" Fill="#9AA0A6" />
                                                        <Ellipse Width="8" Height="8" Fill="#9AA0A6" />
                                                    </UniformGrid>
                                                    <Grid HorizontalAlignment="Left" VerticalAlignment="Center" Width="26" Height="26" Margin="5,0">
                                                        <Ellipse Fill="#C4C7CB" Stroke="#24292F" StrokeThickness="2" />
                                                        <Ellipse Width="7" Height="7" Fill="#24292F" />
                                                    </Grid>
                                                    <Grid HorizontalAlignment="Right" VerticalAlignment="Center" Width="26" Height="26" Margin="5,0">
                                                        <Ellipse Fill="#C4C7CB" Stroke="#24292F" StrokeThickness="2" />
                                                        <Ellipse Width="7" Height="7" Fill="#24292F" />
                                                    </Grid>
                                                </Grid>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Width="6" HorizontalAlignment="Center" Fill="#6E7781" />
                                                    <Rectangle Grid.Column="1" Width="6" HorizontalAlignment="Center" Fill="#6E7781" />
                                                </Grid>
                                            </Grid>

                                            <!-- Sinaleiro (torre de luz): tampa, 3 lentes com brilho, haste e base -->
                                            <Viewbox Visibility="{Binding IsStackLight, Converter={StaticResource B2V}}">
                                                <StackPanel Width="40">
                                                    <Border Width="30" Height="6" CornerRadius="4,4,0,0" Background="#3E444A" />
                                                    <Border Height="26" CornerRadius="3" Background="{Binding StackRed}" BorderBrush="#24292F" BorderThickness="2">
                                                        <Rectangle Width="5" Margin="5,4" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" Fill="White" Opacity="0.3" />
                                                    </Border>
                                                    <Border Height="26" Margin="0,1,0,0" CornerRadius="3" Background="{Binding StackYellow}" BorderBrush="#24292F" BorderThickness="2">
                                                        <Rectangle Width="5" Margin="5,4" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" Fill="White" Opacity="0.3" />
                                                    </Border>
                                                    <Border Height="26" Margin="0,1,0,0" CornerRadius="3" Background="{Binding StackGreen}" BorderBrush="#24292F" BorderThickness="2">
                                                        <Rectangle Width="5" Margin="5,4" HorizontalAlignment="Left" RadiusX="2" RadiusY="2" Fill="White" Opacity="0.3" />
                                                    </Border>
                                                    <Border Width="30" Height="5" Background="#3E444A" />
                                                    <Rectangle Width="7" Height="20" Fill="#6E7781" HorizontalAlignment="Center" />
                                                    <Rectangle Width="30" Height="6" RadiusX="2" RadiusY="2" Fill="#24292F" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Viewbox>
                                        </Grid>
                                    </DockPanel>

                                    <!-- Texto -->
                                    <TextBlock Visibility="{Binding IsText, Converter={StaticResource B2V}}" Text="{Binding Text}" FontSize="{Binding FontSize}"
                                               FontWeight="SemiBold" Foreground="#1F2328" TextWrapping="Wrap" VerticalAlignment="Center" />

                                    <!-- Botão -->
                                    <Button Visibility="{Binding IsButton, Converter={StaticResource B2V}}" Content="{Binding Text}" FontSize="{Binding FontSize}"
                                            FontWeight="SemiBold" Background="{Binding ButtonBrush}" Foreground="{Binding ButtonForeground}"
                                            BorderBrush="#8C959F" Click="HmiButton_Click"
                                            PreviewMouseLeftButtonDown="HmiButton_Down" PreviewMouseLeftButtonUp="HmiButton_Up" />

                                    <!-- Sem comunicação (modo Executar): hachura + aviso, o valor antigo não fica parecendo bom -->
                                    <Grid Visibility="{Binding ShowBadOverlay, Converter={StaticResource B2V}}" ToolTip="{Binding StatusTip}">
                                        <Rectangle RadiusX="6" RadiusY="6" Fill="{StaticResource BadHatch}" />
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-7,0" Width="18" Height="18" CornerRadius="9"
                                                Background="#9A6700" BorderBrush="White" BorderThickness="1.5">
                                            <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>

                                    <!-- Camada de edição: mover, selecionar, redimensionar -->
                                    <Grid Visibility="{Binding IsEditMode, Converter={StaticResource B2V}}" Background="Transparent" Cursor="SizeAll"
                                          MouseLeftButtonDown="Element_MouseDown" MouseMove="Element_MouseMove" MouseLeftButtonUp="Element_MouseUp">
                                        <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="1" Stroke="#AFB8C1" StrokeDashArray="3 3">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Stroke" Value="#0F6CBD" />
                                                            <Setter Property="StrokeThickness" Value="2" />
                                                            <Setter Property="StrokeDashArray" Value="{x:Null}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <TextBlock Text="{Binding BindingText}" FontSize="10" Foreground="#8C959F" FontFamily="Consolas"
                                                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,-16" IsHitTestVisible="False" />
                                        <TextBlock Text="🔒" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-14,0,0"
                                                   Visibility="{Binding Locked, Converter={StaticResource B2V}}" IsHitTestVisible="False" />
                                        <Thumb Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5"
                                               Cursor="SizeNWSE" DragStarted="Resize_DragStarted" DragDelta="Resize_DragDelta"
                                               Visibility="{Binding CanResize, Converter={StaticResource B2V}}">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#0F6CBD" BorderBrush="White" BorderThickness="1.5" CornerRadius="2" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <!-- Piscar (em alarme ou ligado) -->
                                    <DataTrigger Binding="{Binding IsBlinking}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="BlinkAnimation">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0.2" Duration="0:0:0.5" AutoReverse="True" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="BlinkAnimation" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <!-- Fluido andando no tubo -->
                                    <DataTrigger Binding="{Binding IsFlowingForward}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="FlowForward">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="FlowH" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-3" Duration="0:0:0.5" RepeatBehavior="Forever" />
                                                    <DoubleAnimation Storyboard.TargetName="FlowV" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-3" Duration="0:0:0.5" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="FlowForward" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFlowingReverse}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="FlowReverse">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="FlowH" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="3" Duration="0:0:0.5" RepeatBehavior="Forever" />
                                                    <DoubleAnimation Storyboard.TargetName="FlowV" Storyboard.TargetProperty="StrokeDashOffset" From="0" To="3" Duration="0:0:0.5" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="FlowReverse" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <!-- Motor/bomba giram e a esteira anda quando ligados (modo Executar) -->
                                    <DataTrigger Binding="{Binding IsAnimating}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="RunAnimation">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="MotorRotor" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:1.2" RepeatBehavior="Forever" />
                                                    <DoubleAnimation Storyboard.TargetName="PumpRotor" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever" />
                                                    <DoubleAnimation Storyboard.TargetName="BeltPath" Storyboard.TargetProperty="StrokeDashOffset"
                                                                     From="0" To="-4" Duration="0:0:0.4" RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="RunAnimation" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- retângulo de seleção (arrastar no fundo) -->
                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="SelectionRect" Visibility="Collapsed" Stroke="#0F6CBD" StrokeThickness="1" StrokeDashArray="4 2" Fill="#220F6CBD" />
                    </Canvas>
                </Grid>
              </Border>
              <!-- Faixa de alarmes (modo Executar) -->
              <Border x:Name="AlarmBanner" Visibility="Collapsed" Padding="12,6" Background="#1A7F37">
                  <DockPanel>
                      <Button x:Name="AckButton" DockPanel.Dock="Right" Content="Reconhecer" Padding="10,2" Click="Acknowledge_Click" />
                      <TextBlock x:Name="AlarmBannerText" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                  </DockPanel>
              </Border>
            </StackPanel>
          </Viewbox>
        </ScrollViewer>
        <Border x:Name="FullscreenHint" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                Background="#CC1F2328" CornerRadius="6" Padding="12,6" IsHitTestVisible="False">
            <TextBlock Text="Tela cheia · Esc para sair" Foreground="White" />
        </Border>
        </Grid>
    </DockPanel>
</Window>
