<Window x:Class="FieldProbe.App.Views.TypeDetectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detectar tipo" Width="860" Height="560" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12.5" Background="{StaticResource WindowBackground}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Ler novamente" Click="Reload_Click" />
            <Button Content="Cancelar" IsCancel="True" MinWidth="90" />
            <Button Content="Usar selecionado" Style="{StaticResource PrimaryButton}" IsDefault="True" Margin="0" Click="Use_Click" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderText" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Muted}"
                       Text="Compare com o valor esperado (painel da máquina, IHM, manual do fabricante) e escolha a linha que bate. ✔ = interpretação com valor plausível." />
            <TextBlock x:Name="RawText" FontFamily="Consolas" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid x:Name="ResultsGrid" MouseDoubleClick="Grid_MouseDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Plausible}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="" Binding="{Binding PlausibleText, Mode=OneWay}" Width="30" Foreground="#1A7F37" FontWeight="Bold" />
                    <DataGridTextColumn Header="Tipo" Binding="{Binding Type, Mode=OneWay}" Width="80" />
                    <DataGridTextColumn Header="Ordem" Binding="{Binding OrderText, Mode=OneWay}" Width="70" />
                    <DataGridTextColumn Header="Valor" Binding="{Binding Value, Mode=OneWay}" Width="190" FontFamily="Consolas" FontWeight="SemiBold" />
                    <DataGridTextColumn Header="Observação" Binding="{Binding Note, Mode=OneWay}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</Window>
