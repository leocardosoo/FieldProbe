<Window x:Class="FieldProbe.App.Views.PacketDecoderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Decodificar pacote" Width="1000" Height="720" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12.5" Background="{StaticResource WindowBackground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis" />
    </Window.Resources>

    <DockPanel Margin="14">
        <!-- Rodapé -->
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                       Text="Clique num campo para ver os bytes dele · clique num byte para achar o campo" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Copiar bytes (hex)" Click="CopyHex_Click" />
                <Button Content="Copiar explicação" Click="CopyReport_Click" />
                <Button Content="Fechar" IsCancel="True" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="0" />
            </StackPanel>
        </Grid>

        <!-- Cabeçalho -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderText" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,0,0,2" />
            <TextBlock x:Name="InfoText" Style="{StaticResource Muted}" />
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap" Margin="0,8,0,0" />
            <ItemsControl x:Name="WarningsList" Margin="0,6,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFF8C5" BorderBrush="#D4A72C" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,2">
                            <TextBlock Text="{Binding}" Foreground="#7D4E00" TextWrapping="Wrap" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="160" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" MaxHeight="230" />
            </Grid.RowDefinitions>

            <!-- Campos -->
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="FieldsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          SelectionMode="Single" CanUserSortColumns="False" RowHeight="24" GridLinesVisibility="None"
                          SelectionChanged="FieldsGrid_SelectionChanged">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLayer}" Value="True">
                                    <Setter Property="Background" Value="#EEF1F5" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="#0F6CBD" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Offset" Binding="{Binding OffsetText}" Width="56" FontFamily="Consolas" />
                        <DataGridTextColumn Header="Bytes" Binding="{Binding BytesText}" Width="180" FontFamily="Consolas" />
                        <DataGridTextColumn Header="Campo" Binding="{Binding NameText}" Width="250" />
                        <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="250" FontFamily="Consolas" />
                        <DataGridTextColumn Header="O que significa" Binding="{Binding Note}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#57606A" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Note}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Bytes -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="HexRows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding OffsetText}" FontFamily="Consolas" Foreground="#8C959F" Width="44" VerticalAlignment="Center" />
                                    <ItemsControl ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Cell" Width="24" Height="20" CornerRadius="3" Margin="0,0,2,0" Cursor="Hand"
                                                        Background="Transparent" MouseLeftButtonUp="Cell_Click" ToolTip="{Binding ToolTip}">
                                                    <TextBlock Text="{Binding Text}" FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                        <Setter TargetName="Cell" Property="Background" Value="#B6E3FF" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Ascii}" FontFamily="Consolas" Foreground="#57606A" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
