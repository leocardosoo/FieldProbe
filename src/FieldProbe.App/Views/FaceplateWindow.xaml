<Window x:Class="FieldProbe.App.Views.FaceplateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detalhes" Width="380" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="12.5" Background="{StaticResource WindowBackground}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <Style x:Key="Key" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,3,10,3" />
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- Cabeçalho escuro, como num faceplate de SCADA -->
        <Border Background="#1E2D3D" Padding="14,10">
            <DockPanel>
                <Border DockPanel.Dock="Right" CornerRadius="9" Padding="10,2" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#DAFBE1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBad}" Value="True">
                                    <Setter Property="Background" Value="#FFEBE9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding QualityText}" FontWeight="SemiBold" Foreground="#1F2328" />
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Label}" Foreground="White" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding KindName}" Foreground="#AFB8C1" FontSize="11.5" />
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel Margin="16,12,16,16">
            <!-- Valor grande -->
            <Border Background="White" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Padding="12,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding AlarmText}" Foreground="#CF222E" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{Binding ValueForeground}">
                        <Run Text="{Binding DisplayText, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding UnitText, Mode=OneWay}" FontSize="14" Foreground="#8C959F" />
                    </TextBlock>
                </DockPanel>
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Variável" Style="{StaticResource Key}" />
                <TextBlock Grid.Column="1" Text="{Binding BindingText}" Style="{StaticResource Val}" FontFamily="Consolas" />
                <TextBlock Grid.Row="1" Text="Tipo" Style="{StaticResource Key}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DataType}" Style="{StaticResource Val}" />
                <TextBlock Grid.Row="2" Text="Erro" Style="{StaticResource Key}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ErrorText}" Style="{StaticResource Val}" Foreground="#CF222E" />
            </Grid>

            <Button Content="Fechar" IsCancel="True" HorizontalAlignment="Right" MinWidth="90" Margin="0,16,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
