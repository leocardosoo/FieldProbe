<Window x:Class="FieldProbe.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sobre o FieldProbe" Width="640" Height="560" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12.5" Background="{StaticResource WindowBackground}">
    <DockPanel Margin="18">
        <Button DockPanel.Dock="Bottom" Content="Fechar" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                IsCancel="True" IsDefault="True" Margin="0,12,0,0" MinWidth="90" Click="Close_Click" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
            <Image Source="/Assets/fieldprobe-256.png" Width="72" Height="72" Margin="0,0,16,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="FieldProbe" FontSize="24" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" />
                <TextBlock Text="Teste de comunicação com devices industriais" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Top" x:Name="CopyrightText" Margin="0,0,0,6" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,12"
                   Text="Protocolos: Modbus TCP, Modbus RTU (serial e sobre TCP), OPC UA, MQTT 3.1.1, Siemens S7, EtherNet/IP e Mitsubishi MC Protocol (SLMP). Marcas citadas pertencem aos respectivos donos; o FieldProbe não é certificado nem afiliado à OPC Foundation, ODVA, Siemens, Rockwell Automation ou Mitsubishi Electric." />

        <TextBlock DockPanel.Dock="Top" Text="Componentes de terceiros" Style="{StaticResource SectionTitle}" />
        <TextBox x:Name="NoticesText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="11.5" Background="{StaticResource SurfaceBrush}" />
    </DockPanel>
</Window>
