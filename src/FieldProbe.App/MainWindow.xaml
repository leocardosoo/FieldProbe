<Window x:Class="FieldProbe.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FieldProbe.App.ViewModels"
        xmlns:controls="clr-namespace:FieldProbe.App.Controls"
        Title="{Binding Title}" Height="880" Width="1520" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="Assets/fieldprobe.ico"
        FontFamily="Segoe UI" FontSize="12.5" Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextBrush}">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewConnectionCommand}" />
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding ToggleRecordingCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="F2" Command="{Binding EditWatchCommand}" />
        <KeyBinding Key="F9" Command="{Binding ConnectCommand}" />
        <KeyBinding Key="F10" Command="{Binding DisconnectCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- ===================== Menu ===================== -->
        <Menu DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" Padding="4,2">
            <MenuItem Header="_Arquivo">
                <MenuItem Header="_Novo projeto" Command="{Binding NewProjectCommand}" />
                <MenuItem Header="_Abrir projeto..." Command="{Binding OpenProjectCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Salvar projeto" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Salvar projeto _como..." Command="{Binding SaveProjectAsCommand}" />
                <Separator />
                <MenuItem Header="_Exportar log (CSV)..." Command="{Binding ExportLogCommand}" />
                <Separator />
                <MenuItem Header="Sai_r" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Conexão">
                <MenuItem Header="_Nova conexão..." Command="{Binding NewConnectionCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Editar conexão..." Command="{Binding EditConnectionCommand}" />
                <Separator />
                <MenuItem Header="_Conectar" Command="{Binding ConnectCommand}" InputGestureText="F9" />
                <MenuItem Header="Conectar _todas" Command="{Binding ConnectAllCommand}" />
                <MenuItem Header="_Desconectar" Command="{Binding DisconnectCommand}" InputGestureText="F10" />
                <MenuItem Header="_Atualizar árvore" Command="{Binding RefreshCommand}" InputGestureText="F5" />
                <MenuItem Header="Dia_gnóstico do device..." Command="{Binding DiagnosticsCommand}" />
                <MenuItem Header="Procurar _endereços (DBs / registradores)..." Command="{Binding ScanAddressesCommand}" />
                <Separator />
                <MenuItem Header="_Remover conexão" Command="{Binding RemoveConnectionCommand}" />
            </MenuItem>
            <MenuItem Header="_Monitoramento">
                <MenuItem Header="_Gravar leituras em CSV (contínuo)" Command="{Binding ToggleRecordingCommand}" IsChecked="{Binding IsRecording, Mode=OneWay}" InputGestureText="Ctrl+R" />
                <MenuItem Header="_Exportar valores atuais (CSV)..." Command="{Binding ExportSnapshotCommand}" />
                <MenuItem Header="_Zerar estatísticas e histórico" Command="{Binding ResetStatsCommand}" />
                <Separator />
                <MenuItem Header="_Remover item selecionado" Command="{Binding RemoveWatchCommand}" InputGestureText="Del" />
                <MenuItem Header="Remover _todos os itens" Command="{Binding ClearWatchCommand}" />
                <Separator />
                <MenuItem Header="_Confirmar antes de escrever" IsCheckable="True" IsChecked="{Binding ConfirmWrites}" />
                <MenuItem Header="Reconhecer _alarmes" Command="{Binding AcknowledgeAlarmsCommand}" />
            </MenuItem>
            <MenuItem Header="_Ferramentas">
                <MenuItem Header="_Scanner de rede OT..." Command="{Binding OpenScannerCommand}" />
                <MenuItem Header="_Relatório de auditoria de segurança..." Command="{Binding AuditReportCommand}" />
                <Separator />
                <MenuItem Header="_Detectar tipo (Modbus)..." Command="{Binding DetectTypeCommand}" />
                <MenuItem Header="_Editar item selecionado..." Command="{Binding EditWatchCommand}" InputGestureText="F2" />
            </MenuItem>
            <MenuItem Header="A_juda">
                <MenuItem Header="_Sobre o FieldProbe" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- ===================== Barra de ferramentas ===================== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="6,4">
            <WrapPanel>
                <Button Style="{StaticResource ToolButton}" Command="{Binding NewConnectionCommand}" ToolTip="Nova conexão (Ctrl+N)">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" /><TextBlock Text="Nova conexão" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding EditConnectionCommand}" ToolTip="Editar a conexão selecionada (desconectada)">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" /><TextBlock Text="Editar" /></StackPanel>
                </Button>
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="6,2" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding ConnectCommand}" ToolTip="Conectar (F9)">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE768;" Foreground="{StaticResource GoodBrush}" /><TextBlock Text="Conectar" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ConnectAllCommand}" ToolTip="Conectar todas as conexões do projeto">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" /><TextBlock Text="Conectar todas" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding DisconnectCommand}" ToolTip="Desconectar (F10)">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE71A;" Foreground="{StaticResource BadBrush}" /><TextBlock Text="Desconectar" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" ToolTip="Atualizar a árvore (F5)">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" /><TextBlock Text="Atualizar" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding DiagnosticsCommand}" ToolTip="Identificação do device, segurança e estatísticas">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" /><TextBlock Text="Diagnóstico" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding RemoveConnectionCommand}" ToolTip="Remover a conexão selecionada">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" /><TextBlock Text="Remover" /></StackPanel>
                </Button>
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="6,2" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenProjectCommand}" ToolTip="Abrir projeto (Ctrl+O)">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE8E5;" /><TextBlock Text="Abrir" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding SaveProjectCommand}" ToolTip="Salvar projeto (Ctrl+S)">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE74E;" /><TextBlock Text="Salvar" /></StackPanel>
                </Button>
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="6,2" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenScannerCommand}" ToolTip="Descobrir devices industriais numa faixa de IPs">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" /><TextBlock Text="Scanner" /></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding AuditReportCommand}" ToolTip="Gerar relatório de auditoria de segurança OT (HTML/PDF)">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xEA18;" /><TextBlock Text="Auditoria" /></StackPanel>
                </Button>
                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="6,2" />
                <Button Style="{StaticResource ToolButton}" Command="{Binding ToggleRecordingCommand}"
                        ToolTip="Grava continuamente cada leitura dos itens monitorados num CSV até você clicar em 'Parar gravação' (Ctrl+R)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C8;">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding RecordButtonText}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding AboutCommand}" ToolTip="Sobre">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" /><TextBlock Text="Sobre" /></StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- ===================== Barra de status ===================== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding RecordingText}" Foreground="{StaticResource BadBrush}" FontWeight="SemiBold" Margin="0,0,20,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding ActiveAlarmText}" Foreground="{StaticResource BadBrush}" FontWeight="Bold" Margin="0,0,20,0" />
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ===================== Conteúdo ===================== -->
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="300" />
                <RowDefinition Height="6" />
                <RowDefinition Height="220" MinHeight="90" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" MinWidth="240" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== Projeto (árvore) ===== -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="4,2,4,8">
                            <TextBlock Text="Projeto" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                            <TextBlock Text="Duplo clique numa variável para monitorar" Style="{StaticResource Muted}" />
                        </StackPanel>

                        <Grid>
                            <TreeView x:Name="ProjectTree" ItemsSource="{Binding Connections}" BorderThickness="0"
                                      SelectedItemChanged="ProjectTree_SelectedItemChanged"
                                      MouseDoubleClick="ProjectTree_MouseDoubleClick"
                                      PreviewMouseRightButtonDown="ProjectTree_PreviewMouseRightButtonDown"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Monitorar variável" Command="{Binding AddSelectedNodeCommand}" />
                                        <MenuItem Header="Adicionar variável..." Command="{Binding AddVariableCommand}"
                                                  ToolTip="Na conexão: qualquer endereço (ex.: DB12.DBD4, HR:100). Numa pasta: variável dentro dela" />
                                        <MenuItem Header="Editar variável..." Command="{Binding EditVariableCommand}" />
                                        <MenuItem Header="Remover variável" Command="{Binding RemoveVariableCommand}" />
                                        <MenuItem Header="Remover DB da árvore" Command="{Binding RemoveFolderCommand}" />
                                        <Separator />
                                        <MenuItem Header="Conectar" Command="{Binding ConnectCommand}" />
                                        <MenuItem Header="Desconectar" Command="{Binding DisconnectCommand}" />
                                        <MenuItem Header="Atualizar árvore" Command="{Binding RefreshCommand}" />
                                        <MenuItem Header="Diagnóstico..." Command="{Binding DiagnosticsCommand}" />
                                        <MenuItem Header="Procurar endereços..." Command="{Binding ScanAddressesCommand}"
                                                  ToolTip="Descobre quais DBs (Siemens) ou registradores (Modbus) existem no equipamento" />
                                        <Separator />
                                        <MenuItem Header="Editar conexão..." Command="{Binding EditConnectionCommand}" />
                                        <MenuItem Header="Remover conexão" Command="{Binding RemoveConnectionCommand}" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="Padding" Value="4,3" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.Resources>
                                    <!-- Seleção suave (substitui o azul forte do Windows, que deixava o texto ilegível) -->
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E8F1FB" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1F2328" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#EEF1F5" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1F2328" />
                                    <HierarchicalDataTemplate DataType="{x:Type vm:ConnectionViewModel}" ItemsSource="{Binding Nodes}">
                                        <Grid Margin="0,4,0,4" Width="270">
                                            <Grid.ToolTip>
                                                <StackPanel MaxWidth="460">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Protocol}" Foreground="#57606A" />
                                                    <TextBlock Text="{Binding Endpoint}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding ItemCountText}" />
                                                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#57606A" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid.ToolTip>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Selo do protocolo -->
                                            <Border Grid.RowSpan="2" CornerRadius="5" Width="52" Height="34" Margin="0,0,10,0" VerticalAlignment="Top">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#57606A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ProtocolFamily}" Value="Modbus"><Setter Property="Background" Value="#0F6CBD" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding ProtocolFamily}" Value="OpcUa"><Setter Property="Background" Value="#6E40C9" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding ProtocolFamily}" Value="Mqtt"><Setter Property="Background" Value="#1A7F37" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding ProtocolFamily}" Value="S7"><Setter Property="Background" Value="#00838F" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding ProtocolFamily}" Value="Eip"><Setter Property="Background" Value="#C2410C" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ProtocolBadge}" Foreground="White" FontSize="10" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                                            </Border>

                                            <!-- Nome -->
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                            <!-- Etiqueta de estado -->
                                            <Border Grid.Column="2" CornerRadius="9" Padding="7,1,8,1" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EEF1F4" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StateKind}" Value="Connected"><Setter Property="Background" Value="#DAFBE1" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding StateKind}" Value="Connecting"><Setter Property="Background" Value="#DDF4FF" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding StateKind}" Value="Reconnecting"><Setter Property="Background" Value="#FFF8C5" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding StateKind}" Value="Failed"><Setter Property="Background" Value="#FFEBE9" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="#8C959F" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StateKind}" Value="Connected"><Setter Property="Fill" Value="#1A7F37" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding StateKind}" Value="Connecting"><Setter Property="Fill" Value="#0969DA" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding StateKind}" Value="Reconnecting"><Setter Property="Fill" Value="#BF8700" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding StateKind}" Value="Failed"><Setter Property="Fill" Value="#CF222E" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#57606A" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StateKind}" Value="Connected"><Setter Property="Foreground" Value="#1A7F37" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding StateKind}" Value="Connecting"><Setter Property="Foreground" Value="#0969DA" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding StateKind}" Value="Reconnecting"><Setter Property="Foreground" Value="#9A6700" /></DataTrigger>
                                                                    <DataTrigger Binding="{Binding StateKind}" Value="Failed"><Setter Property="Foreground" Value="#CF222E" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>

                                            <!-- Endpoint + nº de itens -->
                                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Subtitle}" FontFamily="Consolas"
                                                       FontSize="11" Foreground="#57606A" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />

                                            <!-- Detalhe só em falha/reconexão -->
                                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Status}" FontSize="11"
                                                       Margin="0,3,0,0" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#9A6700" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StateKind}" Value="Failed"><Setter Property="Foreground" Value="#CF222E" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </HierarchicalDataTemplate>
                                    <HierarchicalDataTemplate DataType="{x:Type vm:TagNodeViewModel}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#0F6CBD" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Subtitle}" Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}"
                                                       FontFamily="Consolas" FontSize="10.5" Foreground="#8C959F" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <!-- "+": cria uma variável nesta pasta (DB de S7, área Modbus) -->
                                            <Button Visibility="{Binding CanAddVariable, Converter={StaticResource BoolToVis}}"
                                                    Click="AddVariableButton_Click" ToolTip="Adicionar variável nesta pasta"
                                                    Margin="8,0,0,0" Padding="0" Width="18" Height="18" Cursor="Hand" Focusable="False">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                                                            <TextBlock x:Name="Plus" Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                       Foreground="#8C959F" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="#DDF4FF" />
                                                                <Setter TargetName="Plus" Property="Foreground" Value="#0F6CBD" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>

                            <!-- Estado vazio -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Connections.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="#B0B7C0" HorizontalAlignment="Center" />
                                <TextBlock Text="Nenhuma conexão no projeto" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,4" />
                                <TextBlock Text="Crie uma conexão para começar a testar Modbus, OPC UA, MQTT, Siemens S7 ou EtherNet/IP." Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="230" />
                                <Button Content="Nova conexão" Style="{StaticResource PrimaryButton}" Command="{Binding NewConnectionCommand}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- ===== Área central ===== -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="250" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <!-- Adicionar item -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel>
                                <WrapPanel.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Margin" Value="0,0,5,0" />
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    </Style>
                                </WrapPanel.Resources>
                                <TextBlock Text="Endereço" />
                                <TextBox Width="260" Margin="0,0,12,0" Text="{Binding ManualAddress, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddManualWatchCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Text="Tipo" />
                                <ComboBox Width="90" Margin="0,0,12,0" ItemsSource="{Binding DataTypes}" SelectedItem="{Binding ManualDataType}" />
                                <TextBlock Text="Ordem" ToolTip="ABCD = big-endian · CDAB = word swap · BADC = byte swap · DCBA = little-endian (só Modbus)" />
                                <ComboBox Width="70" Margin="0,0,12,0" ItemsSource="{Binding ByteOrders}" SelectedItem="{Binding ManualByteOrder}" IsEnabled="{Binding ByteOrderEnabled}" />
                                <TextBlock Text="Tam." ToolTip="Strings: nº de registradores (Modbus) ou de caracteres (S7)" />
                                <TextBox Width="40" Margin="0,0,12,0" Text="{Binding ManualLength, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Ciclo (ms)" ToolTip="Intervalo de polling ou de amostragem (OPC UA)" />
                                <TextBox Width="60" Margin="0,0,12,0" Text="{Binding PollIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddManualWatchCommand}">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Foreground="White" FontSize="12" Margin="0,0,6,0" /><TextBlock Text="Monitorar" Foreground="White" Margin="0" /></StackPanel>
                                </Button>
                                <Button Command="{Binding DetectTypeCommand}" Visibility="{Binding CanDetectType, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Lê o registrador e mostra todas as interpretações (UInt16, Int16, Float32 em todas as ordens...). Só para registradores HR/IR: Coils e Discrete Inputs são bits"
                                        ToolTipService.ShowOnDisabled="True">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="12" Margin="0,0,6,0" /><TextBlock Text="Detectar tipo" Foreground="{StaticResource TextBrush}" Margin="0" /></StackPanel>
                                </Button>
                            </WrapPanel>
                            <TextBlock Text="{Binding AddressHelp}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Data Access View -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="10,8,10,6">
                                <TextBlock Text="Data Access View" Style="{StaticResource SectionTitle}" Margin="0" />
                                <TextBlock Text="duplo clique (ou F2) para editar · botão direito no cabeçalho para escolher as colunas" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                            <DataGrid x:Name="WatchGrid" ItemsSource="{Binding WatchItems}" SelectedItem="{Binding SelectedWatchItem}"
                                      EnableRowVirtualization="True" MouseDoubleClick="WatchGrid_MouseDoubleClick"
                                      RowHeight="38" PreviewMouseRightButtonUp="WatchGrid_PreviewMouseRightButtonUp">
                                <DataGrid.InputBindings>
                                    <KeyBinding Key="Delete" Command="{Binding RemoveWatchCommand}" />
                                </DataGrid.InputBindings>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Editar item (nome, tipo, escala, unidade)..." Command="{Binding EditWatchCommand}" InputGestureText="F2" />
                                        <Separator />
                                        <MenuItem Header="Remover item" Command="{Binding RemoveWatchCommand}" />
                                        <MenuItem Header="Remover todos" Command="{Binding ClearWatchCommand}" />
                                        <Separator />
                                        <MenuItem Header="Zerar estatísticas e histórico" Command="{Binding ResetStatsCommand}" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Quality}" Value="Bad">
                                                <Setter Property="Background" Value="{StaticResource BadRowBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Quality}" Value="Uncertain">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInAlarm}" Value="True">
                                                <Setter Property="Background" Value="#FFEBE9" />
                                                <Setter Property="Foreground" Value="#A40E26" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Conexão" MinWidth="90" Binding="{Binding ConnectionName, Mode=OneWay}" />

                                    <!-- Nome em destaque + endereço embaixo, em cinza -->
                                    <DataGridTemplateColumn Header="Nome" MinWidth="170" Width="220" SortMemberPath="Label">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" ToolTip="{Binding LabelToolTip}">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding AddressText}" FontFamily="Consolas" FontSize="10.5" Foreground="#8C959F"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding ShowAddressUnderName, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Valor alinhado à direita (números) com a unidade em cinza -->
                                    <DataGridTemplateColumn Header="Valor" MinWidth="120" Width="150" SortMemberPath="ValueText">
                                        <DataGridTemplateColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                                <Setter Property="HorizontalContentAlignment" Value="Right" />
                                            </Style>
                                        </DataGridTemplateColumn.HeaderStyle>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding ValueText}">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNumericValue}" Value="True">
                                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{Binding ValueNumberText}" FontFamily="Consolas" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Unit}" Foreground="#8C959F" Margin="4,0,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Qualidade como etiqueta colorida -->
                                    <DataGridTemplateColumn Header="Qualidade" MinWidth="95" SortMemberPath="Quality">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="9" Padding="7,1,9,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FFF8C5" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Quality}" Value="Good"><Setter Property="Background" Value="#DAFBE1" /></DataTrigger>
                                                                <DataTrigger Binding="{Binding Quality}" Value="Bad"><Setter Property="Background" Value="#FFEBE9" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                                            <Ellipse.Style>
                                                                <Style TargetType="Ellipse">
                                                                    <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Quality}" Value="Good"><Setter Property="Fill" Value="{StaticResource GoodBrush}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Quality}" Value="Bad"><Setter Property="Fill" Value="{StaticResource BadBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Ellipse.Style>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Quality}" FontSize="11.5" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Quality}" Value="Good"><Setter Property="Foreground" Value="{StaticResource GoodBrush}" /></DataTrigger>
                                                                        <DataTrigger Binding="{Binding Quality}" Value="Bad"><Setter Property="Foreground" Value="{StaticResource BadBrush}" /></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Alarme" MinWidth="110" SortMemberPath="AlarmState">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding AlarmText}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding AlarmLimitsText}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1A7F37" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInAlarm}" Value="True">
                                                                    <Setter Property="Foreground" Value="#CF222E" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Timestamp" MinWidth="100" Binding="{Binding Timestamp, Mode=OneWay, StringFormat=HH:mm:ss.fff}" FontFamily="Consolas" Foreground="#57606A" />

                                    <!-- Colunas técnicas: escondidas por padrão (botão direito no cabeçalho para mostrar) -->
                                    <DataGridTextColumn Header="Endereço" MinWidth="170" Binding="{Binding AddressText, Mode=OneWay}" FontFamily="Consolas">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="ToolTip" Value="{Binding AddressText}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Tipo" MinWidth="70" Binding="{Binding DataType, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Ordem" MinWidth="60" Binding="{Binding ByteOrderText, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Escala" MinWidth="70" Binding="{Binding ScalingText, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Tipo nativo" MinWidth="95" Binding="{Binding TypeName, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Latência (ms)" MinWidth="100" Binding="{Binding LatencyMs, Mode=OneWay, StringFormat=F1}" />
                                    <DataGridTextColumn Header="Ciclo (ms)" MinWidth="85" Binding="{Binding IntervalMs, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Leituras" MinWidth="75" Binding="{Binding ReadCount, Mode=OneWay}" />
                                    <DataGridTextColumn Header="Erros" MinWidth="55" Binding="{Binding ErrorCount, Mode=OneWay}" />

                                    <DataGridTextColumn Header="Último erro / info" Binding="{Binding Error, Mode=OneWay}" Width="*" MinWidth="220">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="ToolTip" Value="{Binding Error}" />
                                                <Setter Property="ToolTipService.ShowDuration" Value="30000" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" Background="Transparent" />

                    <!-- Tendência / Escrita -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4">
                        <TabControl BorderThickness="0" Background="Transparent">
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE9D2;" FontSize="12" /><TextBlock Text="Tendência" /></StackPanel>
                                </TabItem.Header>
                                <DockPanel Margin="6,4,6,6">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <TextBlock Text="Janela" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}" />
                                            <ComboBox Width="80" ItemsSource="{Binding TrendWindows}" DisplayMemberPath="Label" SelectedValuePath="Seconds"
                                                      SelectedValue="{Binding TrendWindowSeconds}" Margin="0,0,12,0" />
                                            
                                            <CheckBox Content="Pausar" IsChecked="{Binding TrendPaused}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            
                                            
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center">
                                            <Run Text="{Binding SelectedWatchItem.ConnectionName, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding SelectedWatchItem.Label, Mode=OneWay}" />
                                            <Run Text="=" />
                                            <Run Text="{Binding SelectedWatchItem.ValueText, Mode=OneWay}" FontWeight="SemiBold" Foreground="#0F6CBD" />
                                        </TextBlock>
                                    </DockPanel>
                                    <controls:TrendChart x:Name="TrendChartControl" Items="{Binding TrendItems}" WindowSeconds="{Binding TrendWindowSeconds}"
                                                         IsPaused="{Binding TrendPaused}" />
                                </DockPanel>
                            </TabItem>
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;" FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                                    <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UnacknowledgedCount}" Value="0">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding AlarmsTabHeader}" />
                                    </StackPanel>
                                </TabItem.Header>
                                <DockPanel Margin="6,4,6,6">
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Style="{StaticResource ToolButton}" Command="{Binding AcknowledgeAlarmsCommand}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" FontSize="12" /><TextBlock Text="Reconhecer todos" /></StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ToolButton}" Command="{Binding ClearAlarmsCommand}">
                                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE894;" FontSize="12" /><TextBlock Text="Limpar histórico" /></StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                                                   Text="Configure limites alto/baixo e falha de comunicação no item (duplo clique ou F2). Eventos novos ficam em vermelho até serem reconhecidos." />
                                    </DockPanel>
                                    <DataGrid ItemsSource="{Binding Alarms}" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Acknowledged}" Value="False">
                                                        <Setter Property="Foreground" Value="#CF222E" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsReturnToNormal}" Value="True">
                                                        <Setter Property="Foreground" Value="#1A7F37" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Hora" Binding="{Binding Time, Mode=OneWay}" Width="110" />
                                            <DataGridTextColumn Header="Conexão" Binding="{Binding Connection, Mode=OneWay}" Width="120" />
                                            <DataGridTextColumn Header="Item" Binding="{Binding Item, Mode=OneWay}" Width="160" />
                                            <DataGridTextColumn Header="Endereço" Binding="{Binding Address, Mode=OneWay}" Width="160" FontFamily="Consolas" />
                                            <DataGridTextColumn Header="Evento" Binding="{Binding Description, Mode=OneWay}" Width="220" />
                                            <DataGridTextColumn Header="Valor" Binding="{Binding Value, Mode=OneWay}" Width="*" FontFamily="Consolas" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" FontSize="12" /><TextBlock Text="Escrita" /></StackPanel>
                                </TabItem.Header>
                                <StackPanel Margin="10">
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8">
                                        <Run Text="Item selecionado:" />
                                        <Run Text="{Binding SelectedWatchItem.ConnectionName, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding SelectedWatchItem.AddressText, Mode=OneWay}" FontFamily="Consolas" />
                                        <Run Text="· tipo" />
                                        <Run Text="{Binding SelectedWatchItem.DataType, Mode=OneWay}" />
                                        <Run Text="· valor atual" />
                                        <Run Text="{Binding SelectedWatchItem.ValueText, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Novo valor" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Width="240" Margin="0,0,8,0" FontFamily="Consolas" Text="{Binding WriteValue, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding WriteCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Style="{StaticResource PrimaryButton}" Content="Escrever" Command="{Binding WriteCommand}" ToolTip="Ctrl+Enter" />
                                        <CheckBox Content="Confirmar antes de escrever" IsChecked="{Binding ConfirmWrites}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0"
                                               Text="Bool aceita 1/0, true/false, on/off. Números aceitam vírgula ou ponto decimal. No OPC UA o tipo nativo do nó é detectado automaticamente; no MQTT o valor é publicado como texto no tópico." />
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </Border>
                </Grid>
            </Grid>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- ===== Log ===== -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="10,6">
                        <TextBlock Text="Log de comunicação" Style="{StaticResource SectionTitle}" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource ToolButton}" Command="{Binding ExportLogCommand}" ToolTip="Exportar o log em CSV">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE896;" FontSize="12" /><TextBlock Text="Exportar" /></StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" Command="{Binding ClearLogCommand}">
                                <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Glyph}" Text="&#xE894;" FontSize="12" /><TextBlock Text="Limpar" /></StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0" />
                            <TextBox Width="220" Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged, Delay=250}" ToolTip="Filtrar por texto, origem, tipo ou bytes" />
                            <CheckBox Content="Capturar tráfego (TX/RX)" IsChecked="{Binding CaptureTraffic}" Margin="14,0,0,0" VerticalAlignment="Center" />
                            <CheckBox Content="Só erros e avisos" IsChecked="{Binding OnlyErrors}" Margin="14,0,0,0" VerticalAlignment="Center" />
                            <CheckBox Content="Rolagem automática" IsChecked="{Binding AutoScroll}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>

                    <ListView x:Name="LogList" ItemsSource="{Binding LogView}" FontFamily="Consolas" FontSize="12" BorderThickness="0,1,0,0"
                              BorderBrush="{StaticResource BorderBrush}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="TX"><Setter Property="Foreground" Value="#0F6CBD" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="RX"><Setter Property="Foreground" Value="#1A7F37" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="TRACE"><Setter Property="Foreground" Value="#6E40C9" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="ERRO"><Setter Property="Foreground" Value="#CF222E" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="AVISO"><Setter Property="Foreground" Value="#9A6700" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="WRITE"><Setter Property="FontWeight" Value="Bold" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Hora" Width="95" DisplayMemberBinding="{Binding Time}" />
                                <GridViewColumn Header="Origem" Width="120" DisplayMemberBinding="{Binding Source}" />
                                <GridViewColumn Header="Tipo" Width="60" DisplayMemberBinding="{Binding Kind}" />
                                <GridViewColumn Header="Mensagem" Width="2000" DisplayMemberBinding="{Binding Text}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
